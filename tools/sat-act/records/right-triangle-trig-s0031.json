      ]
    },
    "to_scale": true
  },
  "rightAngle": "C",
  "choices": [
    {
      "label": "A",
      "display": "$\\dfrac{8}{17}$",
      "correct": false,
      "note": "$\\sin B$: $\\dfrac{\\text{opp}}{\\text{hyp}}$",
      "why": "$\\frac{8}{17}$ is opposite ÷ hypotenuse for angle $B$, which is $\\sin B$; $\\tan B$ needs opposite ÷ adjacent, $\\frac{8}{15}$.",
      "rationale": "Uses sine or cosine instead of tangent."
    },
    {
      "label": "B",
      "display": "$\\dfrac{8}{15}$",
      "correct": true,
      "note": "Correct",
      "why": "",
