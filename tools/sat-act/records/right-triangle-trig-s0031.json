  "question": {
    "stem": [
      "In right triangle $ABC$, $\\angle C = 90^\\circ$.",
      {
        "math": "\\sin A = \\dfrac{15}{17}"
      }
    ],
    "prompt": "What is $\\tan B$?"
  },
  "figure": {
    "vertices": {
      "C": [
        0,
        0
      ],
      "A": [
        8,
        0
      ],
