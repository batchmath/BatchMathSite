  "figure": null,
  "rightAngle": null,
  "choices": [
    {
      "label": "A",
      "display": "$4$",
      "correct": false,
      "note": "$4$ is extraneous",
      "why": "$x = 4$ solves the squared equation, but in the original equation $\\sqrt{4 + 5} = 3$ while $4 - 7 = -3$, so $4$ is extraneous.",
