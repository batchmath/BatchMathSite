  "question": {
    "id": "u3-ts-root-2-1",
    "variant": "tangent_square_root",
    "answerType": "staged-calculus",
    "stagedFamily": "tangent-secant",
    "approximationMethod": "tangent",
    "concavity": "down",
    "functionFamily": "tangent_square_root",
    "secantTargetFraction": null,
    "secantTargetIsMidpoint": false,
    "questionHtml": "<div class=\"u3-staged-question\"><div class=\"question-prompt\">Use the tangent line to \\(f\\) at \\(x=4\\) to approximate \\(f(5)\\).</div><div>\\(f(x)=\\sqrt{x}\\)</div></div>",
    "stage1": {
      "type": "exact",
      "prompt": "Part 1: Find the approximation.",
      "numericAnswer": 2.25,
      "acceptedExpressions": null,
      "answerTex": "\\frac{9}{4}",
      "requireExact": true,
      "tolerance": 1e-7,
      "placeholder": "Enter the exact approximation",
      "checkLabel": "Check Part 1",
      "keypadMode": "unit3-approximation",
      "explainOnCorrect": false,
      "correctFeedback": "The exact approximation is correct.",
      "incorrectFeedback": "The approximation is not correct.",
      "explanation": "<div class=\"worked-method\"><div class=\"worked-steps\"><p><strong>Step 1:</strong> \\(f(4)=2\\).</p><p><strong>Step 2:</strong> \\(f'(x)=\\frac{1}{2\\sqrt{x}}\\), so \\(f'(4)=\\frac{1}{4}\\).</p><p><strong>Step 3:</strong> Write the actual tangent line: \\(L(x)=2+\\frac{1}{4}\\left(x-4\\right)\\).</p><p><strong>Step 4:</strong> Evaluate it: \\(L(5)=2+\\frac{1}{4}\\left(5-4\\right)=\\frac{9}{4}\\).</p></div></div>"
    },
    "stage2": {
      "type": "choice",
      "prompt": "Part 2: On the actual interval \\([4,5]\\), is this an overestimate or underestimate, and why?",
      "choices": [
        "Overestimate because the function is concave up on the interval",
        "Overestimate because the function is concave down on the interval",
        "Underestimate because the function is concave up on the interval",
        "Underestimate because the function is concave down on the interval"
      ],
      "correctIndex": 1,
      "answerTex": "Overestimate because the function is concave down on the interval",
      "answerIsText": true,
      "correctFeedback": "The classification and concavity reason are correct.",
      "incorrectFeedback": "That classification or concavity reason is not correct.",
      "explanation": "<div class=\"worked-method\"><div class=\"worked-steps\"><p><strong>Step 1:</strong> Differentiate again: \\(f''(x)=-\\frac{1}{4x^{3/2}}\\). On \\([4,5]\\), this is negative, so \\(f\\) is concave down.</p><p><strong>Step 2:</strong> For a concave down function, the tangent line lies above the graph. Therefore the tangent-line approximation is an overestimate.</p></div></div>"
    },
    "answerTex": "\\frac{9}{4}",
