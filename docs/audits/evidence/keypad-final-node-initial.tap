     const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent=fields.length>1?'Check All Answers':'Check Answer';box.appendChild(button);
     const check=()=>{if(!current||current.answered)return;const parser=window.BatchMathDerivativeExpressions,results=[];for(let index=0;index<fields.length;index++){const field=fields[index],rawOriginal=String(inputs[index].value||'').trim().replace(/[−–—]/g,'-');let raw=rawOriginal.replace(/^\s*[A-Za-z][A-Za-z0-9_()]*\s*=\s*/,'');if(!raw){invalidTyped(inputs[index],'Enter every requested value before checking.');return;}try{parser.evaluate(parser.parse(raw),{});}catch(_){invalidTyped(inputs[index],'Enter a valid numerical expression in every answer box.');return;}const places=Number(field.requiredDecimals||0),decimalOk=!places||new RegExp(`^[+-]?(?:\\d+)?\\.\\d{${places}}$`).test(raw),exactOk=!field.requireExact||!/(?:^|[^A-Za-z])(?:\d*\.\d+)/.test(raw);let valueOk=false;if(Array.isArray(field.acceptedExpressions)&&field.acceptedExpressions.length)valueOk=field.acceptedExpressions.some(answer=>parser.equivalent(raw,String(answer),[{}],Number(field.tolerance||1e-7)));else if(field.answer!=null)valueOk=parser.equivalent(raw,String(field.answer),[{}],Number(field.tolerance||1e-7));else{const value=parser.evaluate(parser.parse(raw),{});valueOk=Math.abs(value-Number(field.numericAnswer))<=Number(field.tolerance||(places?.000500000001:1e-7));}results.push({ok:decimalOk&&exactOk&&valueOk,format:decimalOk&&exactOk});}
      current.answered=true;const ok=results.every(result=>result.ok);finishAnalytics(ok);inputs.forEach((input,index)=>{input.disabled=true;input.classList.add(results[index].ok?'correct':'wrong');});button.disabled=true;$('feedback').className='feedback shown';const answers=fields.map(field=>{const value=field.answerTex??field.answer??Number(field.numericAnswer).toFixed(Number(field.requiredDecimals||3));return field.labelText?`${field.labelText} \\(${value}\\)`:`\\(${field.label||''}${value}\\)`;}).join(', '),formatProblem=results.some(result=>!result.format);$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'All entries are correct.':formatProblem?'Use the requested exact form or decimal precision.':'At least one entry needs correction.'}</div>${ok?'':`<div class="correct-answer">Correct answers: ${answers}</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);
     };
     button.addEventListener('click',check);inputs.forEach(input=>input.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();check();}}));appendHintButton(box);mountUnit3Keypad(inputs,box,keypadModeFor('calculus-fields'),check);typeset([box]);setTimeout(()=>inputs[0]?.focus(),0);
    }
    function normalizeWords(raw){return String(raw||'').trim().toLowerCase().replace(/[.!?]/g,'').replace(/\s+/g,' ');}
    function renderTextAnswer(box){
     typedInput(box,{placeholder:current.textPlaceholder||'Enter your answer',aria:'Written answer',help:current.textInputHint||'',check:(input,button)=>{if(!current||current.answered)return;const raw=normalizeWords(input.value);if(!raw){invalidTyped(input,'Enter an answer before checking.');return;}const ok=(current.acceptedText||[]).map(normalizeWords).includes(raw);finishTyped(input,button,ok);}});
    }
    function splitIntervals(raw){
     const text=String(raw||'').trim().replace(/[−–—]/g,'-').replace(/\\cup|∪|\bunion\b/gi,'U');if(!text)return null;const pieces=text.split(/\s*U\s*/).filter(Boolean),out=[];
     for(const piece of pieces){const s=piece.trim(),left=s[0],right=s.at(-1);if(!'(['.includes(left)||!')]'.includes(right))return null;const body=s.slice(1,-1);let depth=0,comma=-1;for(let i=0;i<body.length;i++){if(body[i]==='(')depth++;else if(body[i]===')')depth--;else if(body[i]===','&&depth===0){if(comma>=0)return null;comma=i;}}if(comma<0)return null;out.push({leftClosed:left==='[',rightClosed:right===']',leftRaw:body.slice(0,comma).trim(),rightRaw:body.slice(comma+1).trim()});}
     return out;
    }
    function intervalEndpoint(raw){const s=String(raw||'').trim().toLowerCase().replace(/∞/g,'inf').replace(/\\infty/g,'inf');if(['-inf','-infinity'].includes(s))return-Infinity;if(['inf','+inf','infinity','+infinity'].includes(s))return Infinity;return exactScalarValue(s);}
    function parseIntervals(raw,requiredDecimals=0){
     const pieces=splitIntervals(raw);if(!pieces?.length)return{valid:false};const decimalRE=new RegExp(`^[+-]?(?:\\d+)?\\.\\d{${requiredDecimals}}$`),intervals=[];
     for(const piece of pieces){const left=intervalEndpoint(piece.leftRaw),right=intervalEndpoint(piece.rightRaw);if(Number.isNaN(left)||Number.isNaN(right)||left>=right)return{valid:false};if((!Number.isFinite(left)&&piece.leftClosed)||(!Number.isFinite(right)&&piece.rightClosed))return{valid:false};if((requiredDecimals&&Number.isFinite(left)&&!decimalRE.test(piece.leftRaw))||(requiredDecimals&&Number.isFinite(right)&&!decimalRE.test(piece.rightRaw)))return{valid:false,format:true};intervals.push({...piece,left,right});}
     intervals.sort((a,b)=>a.left-b.left||a.right-b.right);return{valid:true,intervals};
    }
    function renderIntervalAnswer(box){
     const places=Number(current.intervalAnswer?.requiredDecimals||0),help=cfg.unit3?(places?`Write every finite endpoint with exactly ${places} digits after the decimal.`:''):(places?`Use interval notation. Write every finite endpoint with exactly ${places} digits after the decimal; always use parentheses at infinity.`:'Use interval notation. Use parentheses at infinity; for increasing/decreasing intervals, include finite critical endpoints with brackets.');
     typedInput(box,{placeholder:current.intervalPlaceholder||'Enter interval notation',aria:'Interval notation answer',help,check:(input,button)=>{if(!current||current.answered)return;const received=parseIntervals(input.value,places),expected=parseIntervals(current.intervalAnswer?.expected||'',0);if(!received.valid){invalidTyped(input,received.format?`Use exactly ${places} digits after every finite decimal endpoint.`:'Enter a valid answer in interval notation.');return;}const tol=places?.000500001:1e-7,a=received.intervals||[],b=expected.intervals||[],ok=a.length===b.length&&a.every((part,i)=>part.leftClosed===b[i].leftClosed&&part.rightClosed===b[i].rightClosed&&((part.left===b[i].left)||Math.abs(part.left-b[i].left)<=tol)&&((part.right===b[i].right)||Math.abs(part.right-b[i].right)<=tol));finishTyped(input,button,ok);}});
    }
    function renderLineEquation(box){
     box.classList.add('composite-answer','line-equation-answer');
     const input=document.createElement('input');input.type='text';input.id='line-answer';input.className='practice-answer-input';input.placeholder=current.linePlaceholder||'Enter the equation of the line';input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',current.linePlaceholder||'Equation of the line');
     const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent='Check Answer';button.addEventListener('click',()=>chooseLineEquation(input,button));input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();chooseLineEquation(input,button);}});
     box.append(input,button);if(current.lineInputHint){const help=document.createElement('div');help.className='line-answer-help';help.textContent=current.lineInputHint;box.appendChild(help);}mountUnit3Keypad(input,box,keypadModeFor('line-equation'));setTimeout(()=>input.focus(),0);
    }
    function chooseLineEquation(input,button){
     if(!current||current.answered)return;const result=window.BatchMathLineEquations?.check?.(input.value,current.lineAnswer);
     if(!result||!result.valid){input.classList.add('wrong');$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result bad">${result?.message||'Enter a valid equation of a line.'} No attempt counted.</div>`;input.focus();return;}
     current.answered=true;const ok=!!result.correct;finishAnalytics(ok);input.disabled=true;button.disabled=true;input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';const formatNote=!ok&&result.message?`<div class="answer-format-note">${result.message}</div>`:'';const answer=current.lineAnswer?.answerTex||current.answerTex||current.lineAnswer?.equation||'';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':'Not quite.'}</div>${formatNote}${ok?'':`<div class="correct-answer">Correct answer: \\(${answer}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);
    }
    function parseValueList(raw){
     let s=String(raw||'').trim().replace(/[−–—]/g,'-').replace(/[{}\[\]]/g,'').replace(/\b(?:and)\b/gi,',');if(!s)return{valid:false,values:[]};
     s=s.replace(/^\s*[a-z]\s*=\s*/i,'');const parts=s.includes(',')||s.includes(';')?s.split(/[,;]+/):[s];const values=parts.map(x=>exactScalarValue(x.trim()));return{valid:parts.length>0&&values.every(Number.isFinite),values};
    }
    function renderValueList(box){
     box.classList.add('composite-answer','line-equation-answer','value-list-answer');const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=current.valueListPlaceholder||'Enter all values, separated by commas';input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label',current.valueListPlaceholder||'Values');const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent='Check Answer';button.addEventListener('click',check);input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});box.append(input,button);const help=document.createElement('div');help.className='line-answer-help';help.textContent='Separate multiple values with commas. Example: x = a, b, c, …';box.appendChild(help);mountUnit3Keypad(input,box);function check(){if(!current||current.answered)return;const parsed=parseValueList(input.value);if(!parsed.valid){input.classList.add('wrong');$('feedback').className='feedback shown';$('feedback').innerHTML='<div class="result bad">Enter a valid exact value for every requested answer. No attempt counted.</div>';input.focus();return;}const expected=[...(current.valueList?.values||[])].map(Number).sort((a,b)=>a-b),received=[...parsed.values].sort((a,b)=>a-b),ok=expected.length===received.length&&expected.every((v,i)=>Math.abs(v-received[i])<1e-7);current.answered=true;finishAnalytics(ok);input.disabled=true;button.disabled=true;input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':'Not quite.'}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);}setTimeout(()=>input.focus(),0);
    }
    function renderRoundedLineFields(box){
     box.classList.add('composite-answer','rounded-line-answer');const inputs=[];(current.roundedLines||[]).forEach((field,index)=>{const label=document.createElement('label');label.className='rounded-line-field';const title=document.createElement('span');title.textContent=current.roundedLines.length>1?`Line ${index+1}`:'Line';const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=`${field.variable} = 0.000`;input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',`Line ${index+1}: ${field.variable} equals, rounded to three decimals`);label.append(title,input);box.appendChild(label);inputs.push(input);});const button=document.createElement('button');button.type='button';button.className='choice rounded-line-check';button.textContent=current.roundedLines?.length>1?'Check All Lines':'Check Answer';button.addEventListener('click',check);inputs.forEach(input=>input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}}));box.appendChild(button);if(current.lineInputHint){const help=document.createElement('div');help.className='line-answer-help';help.textContent=current.lineInputHint;box.appendChild(help);}mountUnit3Keypad(inputs,box);function check(){if(!current||current.answered)return;const expected=(current.roundedLines||[]).map(f=>({variable:f.variable,value:Number(f.answerText)})),used=new Set(),results=inputs.map(input=>{const raw=input.value.trim().replace(/[−–—]/g,'-'),match=raw.match(/^([xy])\s*=\s*([+-]?(?:\d+\.\d{3}))$/i);if(!match)return{ok:false,format:false};const variable=match[1].toLowerCase(),value=Number(match[2]);const index=expected.findIndex((f,i)=>!used.has(i)&&f.variable===variable&&Math.abs(f.value-value)<1e-9);if(index>=0){used.add(index);return{ok:true,format:true};}return{ok:false,format:true};});const ok=results.length===expected.length&&results.every(r=>r.ok);current.answered=true;finishAnalytics(ok);inputs.forEach((input,i)=>{input.disabled=true;input.classList.add(results[i]?.ok?'correct':'wrong');});button.disabled=true;$('feedback').className='feedback shown';const badFormat=results.some(r=>!r.format);$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':badFormat?'Use x = or y = and exactly three digits after every decimal point.':'At least one rounded line value is incorrect.'}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);}setTimeout(()=>inputs[0]?.focus(),0);
    }
    function renderCoordinateFields(box){
     box.classList.add('composite-answer','coordinate-answer');const spec=current.pointAnswer||{},fields=[['x','x-coordinate'],['y','function value']];const inputs={};
     for(const [key,title] of fields){const label=document.createElement('label');label.className='coordinate-field';const name=document.createElement('span');name.innerHTML=key==='x'?'\\(x=\\)':'\\(f(x)=\\)';const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=`Enter the ${title}`;input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label',title);label.append(name,input);box.appendChild(label);inputs[key]=input;}
     const button=document.createElement('button');button.type='button';button.className='choice coordinate-check';button.textContent='Check Both Coordinates';box.appendChild(button);
     const check=()=>{if(!current||current.answered)return;const parser=window.BatchMathDerivativeExpressions,oks={};for(const key of ['x','y']){const raw=String(inputs[key].value||'').trim().replace(/[−–—]/g,'-').replace(/^\s*(?:x|y|f\s*\(\s*x\s*\))\s*=\s*/i,'');try{parser.evaluate(parser.parse(raw),{});}catch(_){invalidTyped(inputs[key],`Enter a valid exact ${key==='x'?'x-coordinate':'function value'}.`);return;}const expected=Array.isArray(spec[key])?spec[key]:[spec[key]];oks[key]=expected.some(answer=>parser.equivalent(raw,String(answer),[{}],1e-7));}
     current.answered=true;const ok=oks.x&&oks.y;finishAnalytics(ok);for(const key of ['x','y']){inputs[key].disabled=true;inputs[key].classList.add(oks[key]?'correct':'wrong');}button.disabled=true;$('feedback').className='feedback shown';const message=ok?'Both coordinates are correct.':oks.x?'The x-coordinate is correct, but the function value is not.':oks.y?'The function value is correct, but the x-coordinate is not.':'Both coordinates need correction.';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${message}</div>${ok?'':`<div class="correct-answer">Correct point: \\(${current.answerTex}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};
     button.addEventListener('click',check);Object.values(inputs).forEach(input=>input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}}));mountUnit3Keypad(Object.values(inputs),box);typeset([box]);setTimeout(()=>inputs.x.focus(),0);
    }
    function renderParameterFields(box){box.classList.add('composite-answer','parameter-fields');const inputs=[];for(const f of current.fields||[]){const label=document.createElement('label');label.className='parameter-field';label.innerHTML=`<span>\\(${f.label}=\\)</span>`;const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.autocomplete='off';input.placeholder=`Enter ${f.label}`;input.setAttribute('aria-label',`Value of ${f.label}`);label.appendChild(input);box.appendChild(label);inputs.push(input);}let active=inputs[0];inputs.forEach(input=>{input.addEventListener('focus',()=>active=input);input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});});const hint=document.createElement('button');hint.type='button';hint.className='choice';hint.textContent='Show Hint';hint.addEventListener('click',()=>{hint.disabled=true;const d=document.createElement('div');d.className='feedback shown';d.innerHTML=current.hint||'Match the adjacent branch values at each boundary.';box.appendChild(d);typeset([d]);});const checkButton=document.createElement('button');checkButton.type='button';checkButton.className='choice';checkButton.textContent='Check All Parameters';checkButton.addEventListener('click',check);box.append(hint,checkButton);const pad=document.createElement('div');pad.className='u1-keypad';for(const [label,token] of [['7','7'],['8','8'],['9','9'],['−','-'],['4','4'],['5','5'],['6','6'],['a/b','/'],['1','1'],['2','2'],['3','3'],['.','.'],['0','0'],['⌫','backspace'],['Clear','clear']]){const b=document.createElement('button');b.type='button';b.className='u1-key';b.textContent=label;b.addEventListener('click',()=>{if(!active||active.disabled)return;let a=active.selectionStart??active.value.length,z=active.selectionEnd??a;if(token==='clear'){active.value='';a=0;}else if(token==='backspace'){if(a===z)a=Math.max(0,a-1);active.value=active.value.slice(0,a)+active.value.slice(z);}else{active.value=active.value.slice(0,a)+token+active.value.slice(z);a+=token.length;}active.focus();active.setSelectionRange(a,a);});pad.appendChild(b);}box.appendChild(pad);function check(){if(!current||current.answered)return;const parsed=inputs.map(input=>window.BMUnit1UI.parse(input.value));const bad=parsed.findIndex(p=>p.error||p.kind!=='num');if(bad>=0){inputs[bad].classList.add('wrong');$('feedback').className='feedback shown';$('feedback').dataset.answerState='invalid';$('feedback').innerHTML='<div class="result bad">Enter a valid number or fraction in every parameter field. No attempt counted.</div>';inputs[bad].focus();return;}current.answered=true;const oks=parsed.map((p,i)=>Math.abs(p.value-Number(current.fields[i].numericAnswer))<=Number(current.fields[i].numericTolerance||1e-8)),ok=oks.every(Boolean);finishAnalytics(ok);inputs.forEach((input,i)=>{input.disabled=true;input.classList.add(oks[i]?'correct':'wrong');});box.querySelectorAll('button').forEach(b=>b.disabled=true);$('feedback').dataset.answerState='answered';$('feedback').className='feedback shown';const answer=current.fields.map(f=>`\\(${f.label}=${f.answerTex}\\)`).join(', ');$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'All parameters are correct.':'At least one parameter needs correction.'}</div>${ok?'':`<div class="correct-answer">Correct values: ${answer}</div><div class="method">${current.explanation||''}</div>`}`;$('next').hidden=false;if(ok)window.BMUnit1UI.methodButton($('feedback'),current.explanation||'',()=>window.BMAnalytics?.solutionRevealed(current,{reveal_reason:'requested_method'}));typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);}setTimeout(()=>active?.focus(),0);}
    /*
     * Unit 3 theorem/approximation engines use a shared, genuinely staged answer
     * flow. Part 1 is checked before Part 2 is exposed. A correct stage can be
     * advanced with Enter; a wrong stage requires the visible Continue/Next
     * control so one physical keypress never skips the worked feedback.
     */
    function renderStagedCalculus(box){
     const stage1=current.stage1||{},stage2=current.stage2||null;
     box.classList.add('composite-answer','staged-calculus-answer');
     if(current.unit4Meta)box.classList.add('unit4-typed-answer');
     if(current.unit4Meta?.kind==='newton')box.classList.add('unit4-newton-answer');
     if(['geometry','ftc','rules','basic','usub','log','mvt'].includes(current.unit4Meta?.kind))box.classList.add('unit4-revised-answer');
     current.blockEnterAdvance=true;current.enterAdvanceAllowed=false;current.pendingStageAdvance=null;
     current.requirePhysicalNextClick=false;current.nextPointerArmed=false;
     current.stage1Answered=false;current.stage1Correct=false;current.stage2Answered=false;current.stage2Visible=false;

     const panel=document.createElement('section');panel.className='staged-part staged-part-one';panel.setAttribute('aria-label',stage2?'Part 1':'Answer');box.appendChild(panel);
     if(!(['newton','geometry','rules'].includes(current.unit4Meta?.kind)&&stage1.hidePrompt))renderPrompt(panel,stage1.prompt||(stage2?'Part 1':'Enter your answer.'));
     renderStageControl(stage1,panel,(ok)=>finishStage1(ok));

     function renderPrompt(host,text){const prompt=document.createElement('div');prompt.className='question-prompt staged-part-prompt';prompt.innerHTML=text;host.appendChild(prompt);}
     function stageAnswerText(stage){return stage.answerTex||stage.choices?.[stage.correctIndex]||'';}
     function stageFeedback(host,stage,ok,{showExplanation=true,label='Part 1'}={}){
      const note=document.createElement('div');note.className='feedback shown staged-feedback';note.tabIndex=-1;
      const formatNote=!ok&&stage._resultNote?`<div class="answer-format-note">${stage._resultNote}</div>`:'';
      const correctAnswer=!ok&&stageAnswerText(stage)?`<div class="correct-answer">Correct answer: ${stage.answerIsText?stageAnswerText(stage):`\\(${stageAnswerText(stage)}\\)`}</div>`:'';
      const explanation=showExplanation&&stage.explanation?`<div class="method">${stage.explanation}</div>`:'';
      note.innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?(stage.correctFeedback||(stage2?`${label} is correct.`:'Correct.')):(stage.incorrectFeedback||(stage2?`${label} is not correct.`:'Not correct.'))}</div>${formatNote}${correctAnswer}${explanation}`;
      host.appendChild(note);typeset([note]);return note;
     }
     function normalizeStageRaw(raw){return String(raw||'').trim().replace(/[−–—]/g,'-').replace(/^\s*(?:c|x|y|L\([^)]*\)|S\([^)]*\))\s*=\s*/i,'');}
     function decimalLiteralUsed(raw){return /(?:^|[^A-Za-z])(?:\d*\.\d+)/.test(String(raw||''));}
     function exactResult(raw,stage){
      if(stage.unit4Answer)return window.BatchMathUnit4Answers.check(raw,stage.unit4Answer);
      const cleaned=normalizeStageRaw(raw);
      if(!cleaned)return{valid:false,message:stage.requireExact?'Enter an exact answer before checking.':'Enter an answer before checking.'};
      if(stage.requireExact&&decimalLiteralUsed(cleaned))return{valid:true,ok:false,format:true};
      if(stage.type==='exact-list'){
       const parsed=parseValueList(cleaned);if(!parsed.valid)return{valid:false,message:'Enter every exact value, separated by commas.'};
       const expected=[...(stage.expectedValues||[])].map(Number).sort((a,b)=>a-b),received=[...parsed.values].sort((a,b)=>a-b),tol=Number(stage.tolerance||1e-7);
       return{valid:true,ok:expected.length===received.length&&expected.every((value,index)=>Math.abs(value-received[index])<=tol)};
      }
      if(Array.isArray(stage.acceptedExpressions)&&stage.acceptedExpressions.length){
       const parser=window.BatchMathDerivativeExpressions;
       if(parser?.parse&&parser?.evaluate&&parser?.equivalent){
        try{parser.evaluate(parser.parse(cleaned),{});}catch(_){return{valid:false,message:stage.requireExact?'Enter a valid exact numerical expression.':'Enter a valid numerical expression.'};}
        const tolerance=Number(stage.tolerance||1e-7);
        return{valid:true,ok:stage.acceptedExpressions.some(expected=>parser.equivalent(cleaned,String(expected),[{}],tolerance))};
       }
      }
      const value=exactScalarValue(cleaned);if(!Number.isFinite(value))return{valid:false,message:stage.requireExact?'Enter a valid exact numerical expression.':'Enter a valid numerical expression.'};
      return{valid:true,ok:Math.abs(value-Number(stage.numericAnswer))<=Number(stage.tolerance||1e-7)};
     }
     function renderStageControl(stage,host,done){
      if(stage.type==='choice'){
       const grid=document.createElement('div');grid.className='choice-grid staged-choice-grid';host.appendChild(grid);
       (stage.choices||[]).forEach((choice,index)=>{const button=document.createElement('button');button.type='button';button.className='choice staged-choice';button.innerHTML=choice;button.addEventListener('click',()=>{if(stage._answered)return;stage._answered=true;const ok=index===stage.correctIndex;grid.querySelectorAll('.choice').forEach((item,itemIndex)=>{item.disabled=true;if(itemIndex===stage.correctIndex)item.classList.add('correct');else if(itemIndex===index)item.classList.add('wrong');});done(ok);});grid.appendChild(button);});
       return;
      }
      const input=document.createElement('input');input.type='text';input.className='practice-answer-input staged-exact-input';input.placeholder=stage.placeholder||'Enter an exact answer';input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',stage.ariaLabel||stage.placeholder||'Exact answer');
      const button=document.createElement('button');button.type='button';button.className='choice staged-check';button.textContent=stage.checkLabel||(!stage2?'Check Answer':stage===stage1?'Check Part 1':'Check Part 2');
      const invalid=document.createElement('div');invalid.className='staged-input-message';invalid.setAttribute('aria-live','polite');
      const check=()=>{if(stage._answered)return;const result=exactResult(input.value,stage);if(!result.valid){input.classList.add('wrong');invalid.textContent=result.message;input.focus();return;}stage._answered=true;stage._resultNote=result.note||'';invalid.textContent='';input.disabled=true;button.disabled=true;input.classList.add(result.ok?'correct':'wrong');done(result.ok);};
      button.addEventListener('click',check);input.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();event.stopPropagation();check();}});
      host.append(input,button,invalid);mountUnit3Keypad(input,host,stage.keypadMode||'unit3-exact',check);setTimeout(()=>input.focus(),0);
     }
     function finishStage1(ok){
      current.stage1Answered=true;current.stage1Correct=ok;
      const showExplanation=!ok||stage1.explainOnCorrect!==false;
      const note=stageFeedback(panel,stage1,ok,{showExplanation,label:'Part 1'});
      if(!stage2){finishProblem(ok,note,ok);return;}
      if(ok&&stage1.autoAdvanceOnCorrect){
       current.stage2Visible=true;current.pendingStageAdvance=null;current.enterAdvanceAllowed=false;
       renderPart2();return;
      }
      const continueButton=document.createElement('button');continueButton.type='button';continueButton.className='choice staged-continue';continueButton.textContent='Continue to Part 2';
      const advance=()=>{if(current.stage2Visible)return;current.stage2Visible=true;current.pendingStageAdvance=null;current.enterAdvanceAllowed=false;continueButton.disabled=true;continueButton.hidden=true;renderPart2();};
      continueButton.addEventListener('click',advance);
      continueButton.addEventListener('keydown',event=>{if(event.key==='Enter'&&!current.stage1Correct){event.preventDefault();event.stopPropagation();}});
      panel.appendChild(continueButton);current.pendingStageAdvance=advance;current.enterAdvanceAllowed=ok;
      if(ok)setTimeout(()=>continueButton.focus(),0);else setTimeout(()=>note.focus(),0);
     }
     function renderPart2(){
      const part=document.createElement('section');part.className='staged-part staged-part-two';part.setAttribute('aria-label','Part 2');
      if(current.unit4Meta){
       box.insertBefore(part,panel);panel.classList.add('staged-completed');
       panel.querySelectorAll('.bm-calc-keypad,.staged-check,.staged-continue').forEach(e=>e.hidden=true);
       const heading=document.createElement('h3');heading.className='staged-review-heading';heading.textContent='Completed Part 1';panel.prepend(heading);
      }else box.appendChild(part);
      renderPrompt(part,stage2.prompt||'Part 2');
      renderStageControl(stage2,part,(ok)=>{current.stage2Answered=true;const note=stageFeedback(part,stage2,ok,{showExplanation:true,label:'Part 2'});finishProblem(current.stage1Correct&&ok,note,ok);});
      const ready=typeset([part]);
      if(current.unit4Meta){part.tabIndex=-1;ready.then(()=>requestAnimationFrame(()=>{if(!part.isConnected)return;part.focus({preventScroll:true});window.scrollTo({top:Math.max(0,window.scrollY+part.getBoundingClientRect().top-24),behavior:'instant'});}));}
     }
     function finishProblem(overallOk,note,lastStageOk=overallOk){
      const allowNext=Boolean(lastStageOk||current.unit4Meta);
      current.answered=true;current.pendingStageAdvance=null;current.enterAdvanceAllowed=allowNext;current.requirePhysicalNextClick=!allowNext;current.nextPointerArmed=false;finishAnalytics(overallOk);$('next').hidden=false;
      if(allowNext)setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);else setTimeout(()=>note?.focus(),0);
     }
    }

    function renderApproximationFields(box){
     box.classList.add('composite-answer','approximation-fields');const value=document.createElement('input'),kind=document.createElement('input');value.type=kind.type='text';value.className=kind.className='practice-answer-input';value.placeholder='Enter the approximation';kind.placeholder='Enter underestimate or overestimate';value.autocomplete=kind.autocomplete='off';value.setAttribute('aria-label','Approximation');kind.setAttribute('aria-label','Underestimate or overestimate');const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent='Check Both Answers';box.append(value,kind,button);mountUnit3Keypad([value,kind],box);const check=()=>{if(!current||current.answered)return;const numeric=numericValue(value.value),word=normalizeWords(kind.value).replace(/\s+/g,''),expected=current.approximationAnswer||{},numericOk=Number.isFinite(numeric)&&Math.abs(numeric-Number(expected.value))<=Number(current.numericTolerance||.001),classOk=expected.classification==='under'?['under','underestimate'].includes(word):['over','overestimate'].includes(word);if(!Number.isFinite(numeric)||!word){invalidTyped(!Number.isFinite(numeric)?value:kind,'Enter both the approximation and its classification.');return;}current.answered=true;const ok=numericOk&&classOk;finishAnalytics(ok);value.disabled=kind.disabled=button.disabled=true;value.classList.add(numericOk?'correct':'wrong');kind.classList.add(classOk?'correct':'wrong');$('feedback').className='feedback shown';const message=ok?'Both entries are correct.':numericOk?'The approximation is correct, but the classification is not.':classOk?'The classification is correct, but the approximation is not.':'Both entries need correction.';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${message}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex||current.numericAnswer}\\), ${expected.classification==='under'?'underestimate':'overestimate'}</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};button.addEventListener('click',check);for(const input of [value,kind])input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});setTimeout(()=>value.focus(),0);
    }
    function renderComposite(box){box.classList.add('composite-answer');const input=document.createElement('input');input.type='text';input.id='approx-answer';input.className='practice-answer-input';input.placeholder='Approximation';input.autocomplete='off';input.setAttribute('aria-label','Approximation');box.appendChild(input);const row=document.createElement('div');row.className='classification-row';[['under','Underestimate'],['over','Overestimate']].forEach(([key,label])=>{const b=document.createElement('button');b.type='button';b.className='choice classification-choice';b.textContent=label;b.dataset.classification=key;b.addEventListener('click',()=>chooseComposite(key,b,input));row.appendChild(b)});box.appendChild(row);setTimeout(()=>input.focus(),0);}
    function chooseComposite(classification,b,input){if(!current||current.answered)return;const numeric=numericValue(input.value);if(!Number.isFinite(numeric)){input.classList.add('wrong');input.focus();return;}current.answered=true;const tol=Number(current.numericTolerance||0.0005),numericOk=Math.abs(numeric-Number(current.numericAnswer))<=tol,classOk=classification===current.classification,ok=numericOk&&classOk;finishAnalytics(ok);input.disabled=true;input.classList.toggle('correct',numericOk);input.classList.toggle('wrong',!numericOk);document.querySelectorAll('.classification-choice').forEach(x=>{x.disabled=true;if(x.dataset.classification===current.classification)x.classList.add('correct');else if(x===b)x.classList.add('wrong')});$('feedback').className='feedback shown';const detail=ok?'Correct.':(!numericOk&&!classOk?'Both the approximation and classification need correction.':!numericOk?'The classification is right, but the approximation is not.':'The approximation is right, but the classification is not.');$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${detail}</div><div class="correct-answer">Correct approximation: \\(${current.answerTex||current.numericAnswer}\\) · ${current.classification==='under'?'Underestimate':'Overestimate'}</div><div class="method">${ok&&cfg.unit1?'':current.explanation||''}</div>`;$('next').hidden=false;if(cfg.unit1&&ok)window.BMUnit1UI.methodButton($('feedback'),current.explanation||'',()=>window.BMAnalytics?.solutionRevealed(current,{reveal_reason:'requested_method'}));typeset([$('feedback')]);setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);}
    function renderTwoStage(box){
     if((current.stage1CorrectIndex??-1)<0&&current._correctRep&&Array.isArray(current.stage1Choices))current.stage1CorrectIndex=current.stage1Choices.indexOf(current._correctRep);
     current.stage1Answered=false;current.stage1Correct=false;const title=document.createElement('div');title.className='question-prompt';title.textContent=current.stage1Prompt||'Part 1: Select the correct representation.';box.appendChild(title);
     const row=document.createElement('div');row.className='choice-grid two-stage-grid';(current.stage1Choices||[]).forEach((c,i)=>{const b=document.createElement('button');b.type='button';b.className='choice';b.dataset.stage1=String(i);b.innerHTML=`\\(${c}\\)`;b.addEventListener('click',()=>chooseStage1(i,row));row.appendChild(b)});box.appendChild(row);
    }
    function chooseStage1(i,row){if(current.stage1Answered)return;current.stage1Answered=true;current.stage1Correct=i===current.stage1CorrectIndex;row.querySelectorAll('.choice').forEach((b,j)=>{b.disabled=true;if(j===current.stage1CorrectIndex)b.classList.add('correct');else if(j===i)b.classList.add('wrong')});const note=document.createElement('div');note.className='feedback shown';note.innerHTML=current.stage1Correct?'<div class="result good">Part 1 correct.</div>':`<div class="result bad">Part 1 is not correct.</div><div class="correct-answer">Correct representation: \\(${current.stage1Choices[current.stage1CorrectIndex]}\\)</div>`;$('choices').appendChild(note);const p=document.createElement('div');p.className='question-prompt';p.textContent=current.stage2Prompt||'Part 2: Evaluate the definite integral.';$('choices').appendChild(p);const input=document.createElement('input');input.type='text';input.id='stage2-answer';input.className='practice-answer-input';input.placeholder='Enter final value';input.autocomplete='off';const button=document.createElement('button');button.type='button';button.className='choice';button.textContent='Check Part 2';button.addEventListener('click',()=>chooseStage2(input));input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();chooseStage2(input);}});$('choices').append(input,button);typeset([$('choices')]);setTimeout(()=>input.focus(),0);}
    function chooseStage2(input){if(!current||current.answered)return;const val=numericValue(input.value);if(!Number.isFinite(val)){input.classList.add('wrong');return;}current.answered=true;const tol=Number(current.numericTolerance||1e-8),part2=Math.abs(val-Number(current.numericAnswer))<=tol,ok=current.stage1Correct&&part2;finishAnalytics(ok);input.disabled=true;input.classList.add(part2?'correct':'wrong');$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Both parts correct.':part2?'Part 2 is correct; review Part 1.':'Check the evaluation in Part 2.'}</div>${part2?'':`<div class="correct-answer">Correct value: \\(${current.answerTex||current.numericAnswer}\\)</div>`}<div class="method">${ok&&cfg.unit1?'':current.explanation||''}</div>`;$('next').hidden=false;if(cfg.unit1&&ok)window.BMUnit1UI.methodButton($('feedback'),current.explanation||'',()=>window.BMAnalytics?.solutionRevealed(current,{reveal_reason:'requested_method'}));typeset([$('feedback')]);setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);}
    function choose(i,b){if(!current||current.answered)return;current.answered=true;const ok=i===current.correctIndex;finishAnalytics(ok);document.querySelectorAll('#choices > .choice, #choices .choice-grid > .choice').forEach((x,j)=>{x.disabled=true;if(j===current.correctIndex)x.classList.add('correct');else if(j===i)x.classList.add('wrong')});$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':'Not quite.'}</div><div class="method">${ok&&cfg.unit1?'':current.explanation||''}</div>`;$('next').hidden=false;if(cfg.unit1&&ok)window.BMUnit1UI.methodButton($('feedback'),current.explanation||'',()=>window.BMAnalytics?.solutionRevealed(current,{reveal_reason:'requested_method'}));typeset([$('feedback')]);setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);}
    const nextButton=$('next');
    nextButton.addEventListener('pointerdown',()=>{if(current)current.nextPointerArmed=true;});
    nextButton.addEventListener('pointercancel',()=>{if(current)current.nextPointerArmed=false;});
    nextButton.addEventListener('click',event=>{if(current?.requirePhysicalNextClick&&!current.nextPointerArmed){event.preventDefault();event.stopPropagation();return;}if(current)current.nextPointerArmed=false;make();});
    nextButton.addEventListener('keydown',event=>{if((event.key==='Enter'||event.key===' ')&&current?.requirePhysicalNextClick){event.preventDefault();event.stopPropagation();return;}if(event.key==='Enter'&&current?.blockEnterAdvance&&!current.enterAdvanceAllowed){event.preventDefault();event.stopPropagation();}});
    const ids=Array.isArray(cfg.modeSelectIds)?cfg.modeSelectIds:(cfg.modeSelectId?[cfg.modeSelectId]:[]);for(const id of ids){if($(id)&&!cfg.deferModeChange)$(id).addEventListener('change',make);}
    document.addEventListener('keydown',event=>{if(event.key==='Enter'&&current?.requirePhysicalNextClick){event.preventDefault();event.stopImmediatePropagation();}},true);
    document.addEventListener('keydown',event=>{
     if(event.key!=='Enter'||event.defaultPrevented||event.repeat)return;
     if(current?.pendingStageAdvance){
      if(!current.enterAdvanceAllowed){event.preventDefault();return;}
      if(document.activeElement?.tagName==='BUTTON')return;
      event.preventDefault();current.pendingStageAdvance();return;
     }
     if(!current?.answered||$('next').hidden)return;
     if(current.blockEnterAdvance&&!current.enterAdvanceAllowed){event.preventDefault();return;}
     if(document.activeElement?.tagName==='BUTTON')return;
     event.preventDefault();make();
    });
    make();setTimeout(()=>typeset(),500);
    function splitOrderedPair(raw){
     const text=String(raw||'').trim().replace(/[−–—]/g,'-');if(text[0]!=='('||text.at(-1)!==')')return null;const body=text.slice(1,-1);let depth=0,comma=-1;
     for(let i=0;i<body.length;i++){if(body[i]==='(')depth++;else if(body[i]===')')depth--;else if(body[i]===','&&depth===0){if(comma>=0)return null;comma=i;}}
     if(comma<0)return null;const x=body.slice(0,comma).trim(),y=body.slice(comma+1).trim();return x&&y?{x,y}:null;
    }
    function equivalentExact(raw,expected){
     const parser=window.BatchMathDerivativeExpressions;try{parser.evaluate(parser.parse(String(raw)),{});}catch(_){return false;}const values=Array.isArray(expected)?expected:[expected];return values.some(value=>parser.equivalent(String(raw),String(value),[{}],1e-7));
    }
    function renderOrderedPair(box){
     box.classList.add('composite-answer','ordered-pair-answer');const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder='Enter the ordered pair (x, y)';input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label','Ordered pair');const button=document.createElement('button');button.type='button';button.className='choice ordered-pair-check';button.textContent='Check Ordered Pair';box.append(input,button);
     const check=()=>{if(!current||current.answered)return;const received=splitOrderedPair(input.value),expected=current.pointAnswer||{};if(!received){invalidTyped(input,'Enter one ordered pair in the form (x, y).');return;}const xOk=equivalentExact(received.x,expected.x),yOk=equivalentExact(received.y,expected.y),ok=xOk&&yOk;current.answered=true;finishAnalytics(ok);input.disabled=button.disabled=true;input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';const message=ok?'The ordered pair is correct.':xOk?'The x-coordinate is correct, but the y-coordinate is not.':yOk?'The y-coordinate is correct, but the x-coordinate is not.':'Both coordinates need correction.';$('feedback').innerHTML='<div class="result '+(ok?'good':'bad')+'">'+message+'</div>'+(ok?'':'<div class="correct-answer">Correct point: \\('+current.answerTex+'\\)</div>')+'<div class="method">'+(current.explanation||'')+'</div>';$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};
     button.addEventListener('click',check);input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});mountUnit3Keypad(input,box);setTimeout(()=>input.focus(),0);
    }
    function renderExtremumFields(box){
     box.classList.add('composite-answer','extremum-answer');const spec=current.extremumAnswer||{},kind=spec.kind==='minimum'?'minimum':'maximum',fields=[['value','Local '+kind+':','Maximum or minimum value'],['location','Location of '+kind+':','Location of maximum or minimum']];const inputs={};
     for(const [key,labelText,aria] of fields){const label=document.createElement('label');label.className='extremum-field';const title=document.createElement('span');title.textContent=labelText;const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=key==='value'?'Enter the local '+kind+' value':'Enter where it occurs';input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label',aria);label.append(title,input);box.appendChild(label);inputs[key]=input;}
     const button=document.createElement('button');button.type='button';button.className='choice extremum-check';button.textContent='Check Both Answers';box.appendChild(button);
     const check=()=>{if(!current||current.answered)return;for(const key of ['value','location']){if(!String(inputs[key].value||'').trim()){invalidTyped(inputs[key],'Enter both the extremum value and its location.');return;}}const valueOk=equivalentExact(String(inputs.value.value).replace(/^\s*(?:local\s+)?(?:maximum|minimum)\s*=\s*/i,''),spec.value),locationOk=equivalentExact(String(inputs.location.value).replace(/^\s*x\s*=\s*/i,''),spec.location),ok=valueOk&&locationOk;current.answered=true;finishAnalytics(ok);for(const [key,input] of Object.entries(inputs)){input.disabled=true;input.classList.add((key==='value'?valueOk:locationOk)?'correct':'wrong');}button.disabled=true;$('feedback').className='feedback shown';const message=ok?'Both entries are correct.':valueOk?'The extremum value is correct, but its location is not.':locationOk?'The location is correct, but the extremum value is not.':'Both entries need correction.';$('feedback').innerHTML='<div class="result '+(ok?'good':'bad')+'">'+message+'</div>'+(ok?'':'<div class="correct-answer">Correct answer: \\('+current.answerTex+'\\)</div>')+'<div class="method">'+(current.explanation||'')+'</div>';$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};
     button.addEventListener('click',check);Object.values(inputs).forEach(input=>input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}}));mountUnit3Keypad(Object.values(inputs),box);setTimeout(()=>inputs.value.focus(),0);
    }
    })();

  actual: |-
    (function(){
    'use strict';
    const cfg=window.BM_TOPIC_PRACTICE||{};const $=id=>document.getElementById(id);let current=null,correct=0,attempted=0;const recentIds=[];
    function modeValues(){const ids=Array.isArray(cfg.modeSelectIds)?cfg.modeSelectIds:(cfg.modeSelectId?[cfg.modeSelectId]:[]);const out={};for(const id of ids){const el=$(id);if(el)out[id]=el.value;}return out;}
    function generatorOptions(){const modes=modeValues(),first=Object.values(modes)[0]||cfg.defaultMode||null,mode=cfg.fixedMode||first;return Object.assign({mode,modes},modes);}
    function practiceMode(){const vals=modeValues();const parts=Object.entries(vals).map(([k,v])=>`${k}=${v}`);return parts.length?parts.join('|'):(cfg.defaultMode||null);}
    const rawTexCommandRE=/\\(?:frac|dfrac|tfrac|sqrt|pi|infty|pm|mp|cup|cap|leq?|geq?|neq|approx|cdot|times|sin|cos|tan|sec|csc|cot|ln|log|arcsin|arccos|arctan|quad|qquad|theta|Delta|partial|to)\b/;
    function _balanced(s,start,open,close){let d=0;for(let i=start;i<s.length;i++){if(s[i]===open)d++;else if(s[i]===close){d--;if(d===0)return i+1;}}return start;}
    function _cmdEnd(s,i){const m=s.slice(i).match(/^\\([A-Za-z]+)/);if(!m)return i+1;let j=i+m[0].length,name=m[1];if(['frac','dfrac','tfrac'].includes(name)){if(s[j]==='{')j=_balanced(s,j,'{','}');if(s[j]==='{')j=_balanced(s,j,'{','}');return j;}if(name==='sqrt'){if(s[j]==='['){const q=s.indexOf(']',j+1);if(q>=0)j=q+1;}if(s[j]==='{')j=_balanced(s,j,'{','}');return j;}if(['sin','cos','tan','sec','csc','cot','ln','log','arcsin','arccos','arctan'].includes(name)){while(j<s.length&&/\s/.test(s[j]))j++;if(s[j]==='(')j=_balanced(s,j,'(',')');else while(j<s.length&&/[A-Za-z0-9_^{}+\-*/.]/.test(s[j]))j++;return j;}return j;}
    function _wrapRawTexText(text){if(!rawTexCommandRE.test(text))return text;const slots=[];let src=text.replace(/\\\([\s\S]*?\\\)|\\\[[\s\S]*?\\\]/g,m=>{slots.push(m);return `@@BMMATH${slots.length-1}@@`;});let out='',i=0;while(i<src.length){const m=src.slice(i).match(/\\(?:frac|dfrac|tfrac|sqrt|pi|infty|pm|mp|cup|cap|leq?|geq?|neq|approx|cdot|times|sin|cos|tan|sec|csc|cot|ln|log|arcsin|arccos|arctan|quad|qquad|theta|Delta|partial|to)\b/);if(!m){out+=src.slice(i);break;}const st=i+m.index;out+=src.slice(i,st);const en=_cmdEnd(src,st);out+=`\\(${src.slice(st,en)}\\)`;i=en;}return out.replace(/@@BMMATH(\d+)@@/g,(_,n)=>slots[+n]);}
    function normalizeRawMath(root){if(!root)return;const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);const nodes=[];while(walker.nextNode())nodes.push(walker.currentNode);for(const n of nodes){if(n.parentElement?.closest('mjx-container,script,style,textarea'))continue;const v=n.nodeValue||'',next=_wrapRawTexText(v);if(next!==v)n.nodeValue=next;}}
    function typeset(nodes){const list=(nodes||[document.body]).filter(Boolean);for(const n of list)normalizeRawMath(n);return window.MathJax?.typesetPromise?window.MathJax.typesetPromise(list).catch(()=>{}):Promise.resolve();}
    function analyticsMode(){const mode=practiceMode(),base=cfg.analyticsSlug||cfg.slug||'mixed_review';return mode?`${base}:${mode}`:base;}
    function finishAnalytics(ok){window.BMAnalytics?.answerChecked(current,ok,{practice_mode:analyticsMode()});if(ok)correct++;else window.BMAnalytics?.solutionRevealed(current,{practice_mode:analyticsMode()});attempted++;$('correct-count').textContent=String(correct);$('attempted-count').textContent=String(attempted);}
    function cleanDisplayMath(value){if(typeof value!=='string')return value;const powers=value.replace(/\^\{1\}/g,'').replace(/\^1(?!\d)/g,'');return window.BatchMathAnswers?.normalizeTexFractionSigns?.(powers)??powers;}
    function cleanProblemDisplay(p){
     // Exact Unit 4 renderers already normalize their own powers and fraction signs.
     // Do not mistake an integral's upper bound ^{1} for a removable first power.
     if(p.normalizedMathDisplay===true)return p;
     for(const key of ['questionHtml','explanation','answerTex','hint','diagramHint','stage1Prompt','stage2Prompt'])if(key in p)p[key]=cleanDisplayMath(p[key]);
     for(const key of ['choices','stage1Choices'])if(Array.isArray(p[key]))p[key]=p[key].map(cleanDisplayMath);
     for(const stageKey of ['stage1','stage2']){
      const stage=p[stageKey];if(!stage||typeof stage!=='object')continue;
      for(const key of ['prompt','explanation','answerTex','correctFeedback'])if(key in stage)stage[key]=cleanDisplayMath(stage[key]);
      if(Array.isArray(stage.choices))stage.choices=stage.choices.map(cleanDisplayMath);
     }
     return p;
    }
    function make(){
     const activeSlug=Array.isArray(cfg.slugs)&&cfg.slugs.length?cfg.slugs[Math.floor((window.BatchMathRNG?.random?.()??0.5)*cfg.slugs.length)]:cfg.slug;
     const gen=window.BatchMathAPTopicGenerators?.get(activeSlug);if(!gen){$('question').innerHTML='<div>No generator is configured for this topic yet.</div>';return;}
     let candidate=null;for(let tries=0;tries<12;tries++){candidate=gen(generatorOptions());if(!candidate||!recentIds.includes(candidate.id))break;}if(!candidate){$('question').textContent='Practice generator unavailable.';return;}if(cfg.unit1&&!candidate.keypadMode){if(['introduction-to-limits','sin-one-over-x'].includes(activeSlug))candidate.keypadMode='no-infinity';else if(activeSlug==='squeeze-course-practice')candidate.keypadMode='finite';}cleanProblemDisplay(candidate);
     current=candidate;current.answered=false;recentIds.push(current.id);while(recentIds.length>6)recentIds.shift();current.problemType=activeSlug;current.problemVariant=current.variant;current.generatorVersion=cfg.generatorVersion||'1';current.problemId=current.id;window.BMAnalytics?.ensurePracticeStarted({practice_mode:analyticsMode()});window.BMAnalytics?.problemGenerated(current,{practice_mode:analyticsMode()});
     $('question').innerHTML=current.questionHtml;const box=$('choices');box.innerHTML='';box.className='choice-grid';if(current.fullWidthChoices||current.calculatorActive)box.classList.add('single-column');$('feedback').className='feedback';$('feedback').innerHTML='';if(cfg.unit1)delete $('feedback').dataset.answerState;$('next').hidden=true;
     if(current.answerType==='unit5-staged'&&window.BatchMathUnit5UI){window.BatchMathUnit5UI.render(box,current,unit5Host());}else if(current.answerType==='numeric'){renderNumeric(box);}else if(current.answerType==='exact-expression'){renderExactExpression(box);}else if(current.answerType==='calculus-fields'){renderCalculusFields(box);}else if(current.answerType==='text-answer'){renderTextAnswer(box);}else if(current.answerType==='interval-answer'){renderIntervalAnswer(box);}else if(current.answerType==='line-equation'){renderLineEquation(box);}else if(current.answerType==='value-list'){renderValueList(box);}else if(current.answerType==='rounded-line-fields'){renderRoundedLineFields(box);}else if(current.answerType==='ordered-pair'){renderOrderedPair(box);}else if(current.answerType==='extremum-fields'){renderExtremumFields(box);}else if(current.answerType==='coordinate-fields'){renderCoordinateFields(box);}else if(current.answerType==='parameter-fields'){renderParameterFields(box);}else if(current.answerType==='staged-calculus'){renderStagedCalculus(box);}else if(current.answerType==='two-stage'){renderTwoStage(box);}else if(current.answerType==='approximation-fields'){renderApproximationFields(box);}else if(current.answerType==='approx-classification'){renderComposite(box);}else renderChoices(box);
     box.querySelectorAll('.u1-keypad:not(.u1-keypad-standardized)').forEach(pad=>window.BMUnit1UI?.layoutKeypad?.(pad));
     typeset([$('question'),box]);
    }
    // v12.8.W Unit 5 multi-part problems render in unit5-ui.js; this is how they report back.
    function unit5Host(){return{typeset,finish:ok=>{current.answered=true;current.pendingStageAdvance=null;current.enterAdvanceAllowed=true;current.requirePhysicalNextClick=false;finishAnalytics(ok);$('next').hidden=false;setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);}};}
    function renderChoices(box){for(let i=0;i<(current.choices||[]).length;i++){const c=current.choices[i],s=String(c),b=document.createElement('button');b.type='button';b.className='choice';b.dataset.index=String(i);const delimited=/\\\(|\\\[/.test(s);const mathLike=/\\[A-Za-z]+|[=<>≤≥±∞π^_]|^\s*[xyft]\s*(?:=|<|>|≤|≥)|^\s*\(?[-+]?\d/.test(s);if(current.choicesHtml||delimited)b.innerHTML=s;else if(current.choicesAreText&&!mathLike)b.textContent=s;else b.innerHTML=`\\(${s}\\)`;b.addEventListener('click',()=>choose(i,b));box.appendChild(b);}}
    function insertAtCursor(input,token){if(!input||input.disabled)return;let a=input.selectionStart??input.value.length,z=input.selectionEnd??a;if(token==='clear'){input.value='';a=0;}else if(token==='backspace'){if(a===z)a=Math.max(0,a-1);input.value=input.value.slice(0,a)+input.value.slice(z);}else{input.value=input.value.slice(0,a)+token+input.value.slice(z);a+=token.length;}input.focus();input.setSelectionRange(a,a);input.dispatchEvent(new Event('input',{bubbles:true}));}
    function standardizeU3Keypad(pad){
     const digits={7:[1,1],8:[1,2],9:[1,3],4:[2,1],5:[2,2],6:[2,3],1:[3,1],2:[3,2],3:[3,3],0:[4,3]};
     const open=[[1,4],[1,5],[2,4],[2,5],[3,4],[3,5],[4,1],[4,2],[4,4],[4,5]],ordinary=[],wide=[];
     [...pad.children].forEach(button=>{const label=String(button.textContent||'').trim(),cell=digits[label];if(cell){button.style.gridRow=String(cell[0]);button.style.gridColumn=String(cell[1]);}else if(/^(?:Undefined|No Solution|Infinite Solutions|Underestimate|Overestimate)$/i.test(label)){button.classList.add('u3-key-double');wide.push(button);}else ordinary.push(button);});
     open.forEach((cell,index)=>{const button=ordinary[index];if(button){button.style.gridRow=String(cell[0]);button.style.gridColumn=String(cell[1]);}});
     const overflow=[...wide,...ordinary.slice(open.length)];if(overflow.length){const continuation=document.createElement('div');continuation.className='u3-keypad-continuation';overflow.forEach(button=>{button.style.gridRow='';button.style.gridColumn='';continuation.appendChild(button);});pad.appendChild(continuation);}
     pad.classList.add('u3-keypad-standardized');
    }
    function mountUnit3Keypad(inputs,box,mode='unit3',onCheck=null){
     if(!cfg.unit3&&!current?.unit4Meta)return;if(mode==='unit3')mode=keypadModeFor(current?.answerType,'unit3-exact');const list=(Array.isArray(inputs)?inputs:[inputs]).filter(Boolean);if(!list.length)return;
     const checkButton=[...box.querySelectorAll('button')].find(b=>/^Check\b/i.test(b.textContent||''));
     if(window.BatchMathCalculusKeypad?.mountInputs){
       window.BatchMathCalculusKeypad.mountInputs(list,box,{mode,onCheck:onCheck||(()=>{if(checkButton&&!checkButton.disabled)checkButton.click();})});
       return;
     }
     let active=list[0];for(const input of list)input.addEventListener('focus',()=>active=input);
     const pad=document.createElement('div');pad.className='u3-keypad';pad.setAttribute('aria-label','Math answer keypad');
     const keys=[['7','7'],['8','8'],['9','9'],['−','-'],['x','x'],['y','y'],['4','4'],['5','5'],['6','6'],['+','+'],['π','pi'],['e','e'],['1','1'],['2','2'],['3','3'],['×','*'],['ln','ln('],['√','sqrt('],['0','0'],['.','.'],['a/b','/'],['(','('],[')',')'],['x =','x='],['y =','y='],['c =','c='],[',',','],['[','['],[']',']'],['∞','infinity'],['−∞','-infinity'],['∪','U'],['Under','underestimate'],['Over','overestimate'],['^','^'],['⌫','backspace'],['Clear','clear']];
     for(const [label,token] of keys){const b=document.createElement('button');b.type='button';b.className='u3-key';if(label==='∞'||label==='−∞')b.classList.add('math-infinity-key');b.textContent=label;b.addEventListener('click',()=>insertAtCursor(active,token));pad.appendChild(b);}standardizeU3Keypad(pad);box.appendChild(pad);
    }
    function keypadModeFor(answerType,fallback){
     if(current?.keypadMode)return current.keypadMode;
     const type=answerType||current?.answerType||'';
     if(type==='numeric')return Number(current?.requiredDecimals||0)?'unit3-rounded':'unit3-number';
     if(type==='exact-expression')return ['optimization','related-rates'].includes(current?.topicSlug)?'unit3-geometry-exact':'unit3-exact';
     if(type==='calculus-fields')return current?.calculatorActive?'unit3-rounded':(['optimization','related-rates'].includes(current?.topicSlug)?'unit3-geometry-exact':'unit3-exact');
     if(type==='interval-answer')return'unit3-interval';
     if(type==='line-equation')return'unit3-equation';
     if(type==='value-list')return'unit3-list';
     if(type==='rounded-line-fields')return'unit3-rounded-line';
     if(type==='ordered-pair')return'unit3-pair';
     if(type==='coordinate-fields'||type==='extremum-fields')return'unit3-coordinate';
     if(type==='approximation-fields'||type==='approx-classification')return'unit3-approximation';
     return fallback||'unit3-exact';
    }
    function appendAnswerLabel(box){if(!current?.answerLabelText)return;const label=document.createElement('div');label.className='answer-entry-label';label.textContent=current.answerLabelText;box.appendChild(label);}
    function renderNumeric(box){box.classList.add('composite-answer');appendAnswerLabel(box);const input=document.createElement('input');input.type='text';input.id='numeric-answer';input.className='practice-answer-input';input.placeholder=current.numericPlaceholder||'Enter answer';input.autocomplete='off';input.setAttribute('aria-label',current.answerLabelText||current.numericPlaceholder||'Answer');const button=document.createElement('button');button.type='button';button.className='choice';button.textContent='Check Answer';button.addEventListener('click',()=>chooseNumeric(input));input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();chooseNumeric(input);}});box.append(input,button);appendHintButton(box);if(cfg.unit1)window.BMUnit1UI.keypad(input,box,current.keypadMode||'standard');mountUnit3Keypad(input,box,keypadModeFor('numeric'));setTimeout(()=>input.focus(),0);}
    function numericValue(raw){raw=window.BatchMathAnswers?.normalizeFractionSigns(raw) ?? raw;const s=String(raw||'').trim().replace(/,/g,'').replace(/≈/g,'').replace(/π/g,'pi');if(/^[-+]?\d+\s*\/\s*[-+]?\d+$/.test(s)){const [a,b]=s.split('/').map(Number);return b? a/b:NaN;}const direct=Number(s);if(Number.isFinite(direct))return direct;try{const parser=window.BatchMathDerivativeExpressions;return parser.evaluate(parser.parse(s),{});}catch(_){return NaN;}}
    function chooseNumeric(input){if(!current||current.answered)return;const parsed=cfg.unit1?window.BMUnit1UI.parse(input.value):null;const raw=String(input.value||'').trim().replace(/[−–—]/g,'-'),val=cfg.unit1?(parsed.kind==='num'?parsed.value:NaN):numericValue(raw);if(cfg.unit1?!!parsed.error:!Number.isFinite(val)){input.classList.add('wrong');$('feedback').className='feedback shown';if(cfg.unit1)$('feedback').dataset.answerState='invalid';$('feedback').innerHTML='<div class="result bad">'+(parsed?.error||'Enter a numerical answer before checking.')+'</div>';input.focus();return;}const places=Number(current.requiredDecimals||0),formatOk=!places||new RegExp(`^[+-]?(?:\\d+)?\\.\\d{${places}}$`).test(raw);current.answered=true;const tol=Number(current.numericTolerance||0.0006),valueOk=Math.abs(val-Number(current.numericAnswer))<=tol,ok=formatOk&&valueOk;finishAnalytics(ok);input.disabled=true;if(cfg.unit1){$('feedback').dataset.answerState='answered';$('choices').querySelectorAll('button').forEach(b=>b.disabled=true);}input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';const result=ok?'Correct.':!formatOk?`Enter the answer with exactly ${places} digits after the decimal point.`:'Not quite.';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${result}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex||current.numericAnswer}\\)</div>`}<div class="method">${ok&&cfg.unit1?'':current.explanation||''}</div>`;$('next').hidden=false;if(cfg.unit1&&ok)window.BMUnit1UI.methodButton($('feedback'),current.explanation||'',()=>window.BMAnalytics?.solutionRevealed(current,{reveal_reason:'requested_method'}));typeset([$('feedback')]);setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);}
    function appendHintButton(box){
     const hints=[];
     if(current?.hint)hints.push({html:current.hint,label:current.hintButtonLabel||'Show Hint',kind:'formula'});
     if(current?.diagramHint)hints.push({html:current.diagramHint,label:current.diagramHintButtonLabel||'Diagram Hint',kind:'diagram'});
     for(const item of hints){
      const button=document.createElement('button');button.type='button';button.className='choice hint-reveal';button.textContent=item.label;button.setAttribute('aria-expanded','false');
      const hint=document.createElement('div');hint.className='feedback shown practice-hint '+(item.kind==='diagram'?'practice-diagram-hint':'practice-formula-hint');hint.innerHTML=item.html;hint.hidden=true;
      button.addEventListener('click',()=>{const opening=hint.hidden;hint.hidden=!opening;button.setAttribute('aria-expanded',String(opening));button.textContent=opening?`Hide ${item.label}`:item.label;if(opening)typeset([hint]);});
      box.append(button,hint);
     }
    }
    // Let adapters choose controls from the generated field's format requirements.
    // These attributes do not change input translation, answer values or grading.
    function unit3FieldControls(input,answer){
     if(!cfg.unit3||!answer)return;
     if(answer.answerType==='interval-answer')input.dataset.bmIntervalDecimals=String(Number(answer.intervalAnswer?.requiredDecimals||0));
     const values=[answer.expressionAnswer,answer.numericAnswer].concat(answer.acceptedExpressions||[]);
     if(!answer.requireExact&&values.some(value=>/\d*\.\d+/.test(String(value??''))))input.dataset.bmAllowDecimal='true';
    }
    function typedInput(box,{placeholder='Enter answer',aria='Answer',help='',check}){
     box.classList.add('composite-answer','line-equation-answer');appendAnswerLabel(box);const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=placeholder;input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',current?.answerLabelText||aria);unit3FieldControls(input,current);const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent='Check Answer';button.addEventListener('click',()=>check(input,button));input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check(input,button);}});box.append(input,button);if(help){const note=document.createElement('div');note.className='line-answer-help';note.textContent=help;box.appendChild(note);}appendHintButton(box);mountUnit3Keypad(input,box,keypadModeFor(current?.answerType));setTimeout(()=>input.focus(),0);
    }
    function invalidTyped(input,message){input.classList.add('wrong');$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result bad">${message} No attempt counted.</div>`;input.focus();}
    function finishTyped(input,button,ok,badMessage='Not quite.'){
     current.answered=true;finishAnalytics(ok);input.disabled=true;button.disabled=true;input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':badMessage}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);
    }
    function exactScalarValue(raw){
     const simple=numericValue(raw);if(Number.isFinite(simple))return simple;const parser=window.BatchMathDerivativeExpressions;try{return parser.evaluate(parser.parse(String(raw||'')),{});}catch(_){return NaN;}
    }
    function renderExactExpression(box){
     typedInput(box,{placeholder:current.expressionPlaceholder||'Enter an exact answer',aria:'Exact answer',help:cfg.unit3?'':'Use exact values such as pi/6, sqrt(3), or ln(2) when needed.',check:(input,button)=>{if(!current||current.answered)return;let raw=String(input.value||'').trim().replace(/[−–—]/g,'-').replace(/^\s*(?:[avtxy]|speed|velocity|acceleration)\s*=\s*/i,'');const parser=window.BatchMathDerivativeExpressions;try{parser.evaluate(parser.parse(raw),{});}catch(_){invalidTyped(input,'Enter a valid exact numerical expression.');return;}const exactFormatOk=!current.requireExact||!/(?:^|[^A-Za-z])(?:\d*\.\d+)/.test(raw),expected=current.acceptedExpressions||[current.expressionAnswer],ok=exactFormatOk&&expected.some(answer=>parser.equivalent(raw,String(answer),[{}],1e-7));finishTyped(input,button,ok,exactFormatOk?'Not quite.':'Use an exact form rather than a decimal approximation.');}});
    }
    function renderCalculusFields(box){
     box.classList.add('composite-answer','parameter-fields','calculus-fields');if(current?.topicSlug==='related-rates')box.classList.add('related-rates-context-fields');const fields=current.fields||[],inputs=[];
     for(const field of fields){const label=document.createElement('label');label.className='parameter-field calculus-field';const name=document.createElement('span');if(field.labelText){name.textContent=field.labelText;name.className='calculus-field-text-label';}else{name.innerHTML=`\\(${field.label||''}\\)`;}const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=field.placeholder||'Enter the value';input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',field.ariaLabel||field.labelText||field.label||'Answer');unit3FieldControls(input,field);label.append(name,input);box.appendChild(label);inputs.push(input);}
     const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent=fields.length>1?'Check All Answers':'Check Answer';box.appendChild(button);
     const check=()=>{if(!current||current.answered)return;const parser=window.BatchMathDerivativeExpressions,results=[];for(let index=0;index<fields.length;index++){const field=fields[index],rawOriginal=String(inputs[index].value||'').trim().replace(/[−–—]/g,'-');let raw=rawOriginal.replace(/^\s*[A-Za-z][A-Za-z0-9_()]*\s*=\s*/,'');if(!raw){invalidTyped(inputs[index],'Enter every requested value before checking.');return;}try{parser.evaluate(parser.parse(raw),{});}catch(_){invalidTyped(inputs[index],'Enter a valid numerical expression in every answer box.');return;}const places=Number(field.requiredDecimals||0),decimalOk=!places||new RegExp(`^[+-]?(?:\\d+)?\\.\\d{${places}}$`).test(raw),exactOk=!field.requireExact||!/(?:^|[^A-Za-z])(?:\d*\.\d+)/.test(raw);let valueOk=false;if(Array.isArray(field.acceptedExpressions)&&field.acceptedExpressions.length)valueOk=field.acceptedExpressions.some(answer=>parser.equivalent(raw,String(answer),[{}],Number(field.tolerance||1e-7)));else if(field.answer!=null)valueOk=parser.equivalent(raw,String(field.answer),[{}],Number(field.tolerance||1e-7));else{const value=parser.evaluate(parser.parse(raw),{});valueOk=Math.abs(value-Number(field.numericAnswer))<=Number(field.tolerance||(places?.000500000001:1e-7));}results.push({ok:decimalOk&&exactOk&&valueOk,format:decimalOk&&exactOk});}
      current.answered=true;const ok=results.every(result=>result.ok);finishAnalytics(ok);inputs.forEach((input,index)=>{input.disabled=true;input.classList.add(results[index].ok?'correct':'wrong');});button.disabled=true;$('feedback').className='feedback shown';const answers=fields.map(field=>{const value=field.answerTex??field.answer??Number(field.numericAnswer).toFixed(Number(field.requiredDecimals||3));return field.labelText?`${field.labelText} \\(${value}\\)`:`\\(${field.label||''}${value}\\)`;}).join(', '),formatProblem=results.some(result=>!result.format);$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'All entries are correct.':formatProblem?'Use the requested exact form or decimal precision.':'At least one entry needs correction.'}</div>${ok?'':`<div class="correct-answer">Correct answers: ${answers}</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);
     };
     button.addEventListener('click',check);inputs.forEach(input=>input.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();check();}}));appendHintButton(box);mountUnit3Keypad(inputs,box,keypadModeFor('calculus-fields'),check);typeset([box]);setTimeout(()=>inputs[0]?.focus(),0);
    }
    function normalizeWords(raw){return String(raw||'').trim().toLowerCase().replace(/[.!?]/g,'').replace(/\s+/g,' ');}
    function renderTextAnswer(box){
     typedInput(box,{placeholder:current.textPlaceholder||'Enter your answer',aria:'Written answer',help:current.textInputHint||'',check:(input,button)=>{if(!current||current.answered)return;const raw=normalizeWords(input.value);if(!raw){invalidTyped(input,'Enter an answer before checking.');return;}const ok=(current.acceptedText||[]).map(normalizeWords).includes(raw);finishTyped(input,button,ok);}});
    }
    function splitIntervals(raw){
     const text=String(raw||'').trim().replace(/[−–—]/g,'-').replace(/\\cup|∪|\bunion\b/gi,'U');if(!text)return null;const pieces=text.split(/\s*U\s*/).filter(Boolean),out=[];
     for(const piece of pieces){const s=piece.trim(),left=s[0],right=s.at(-1);if(!'(['.includes(left)||!')]'.includes(right))return null;const body=s.slice(1,-1);let depth=0,comma=-1;for(let i=0;i<body.length;i++){if(body[i]==='(')depth++;else if(body[i]===')')depth--;else if(body[i]===','&&depth===0){if(comma>=0)return null;comma=i;}}if(comma<0)return null;out.push({leftClosed:left==='[',rightClosed:right===']',leftRaw:body.slice(0,comma).trim(),rightRaw:body.slice(comma+1).trim()});}
     return out;
    }
    function intervalEndpoint(raw){const s=String(raw||'').trim().toLowerCase().replace(/∞/g,'inf').replace(/\\infty/g,'inf');if(['-inf','-infinity'].includes(s))return-Infinity;if(['inf','+inf','infinity','+infinity'].includes(s))return Infinity;return exactScalarValue(s);}
    function parseIntervals(raw,requiredDecimals=0){
     const pieces=splitIntervals(raw);if(!pieces?.length)return{valid:false};const decimalRE=new RegExp(`^[+-]?(?:\\d+)?\\.\\d{${requiredDecimals}}$`),intervals=[];
     for(const piece of pieces){const left=intervalEndpoint(piece.leftRaw),right=intervalEndpoint(piece.rightRaw);if(Number.isNaN(left)||Number.isNaN(right)||left>=right)return{valid:false};if((!Number.isFinite(left)&&piece.leftClosed)||(!Number.isFinite(right)&&piece.rightClosed))return{valid:false};if((requiredDecimals&&Number.isFinite(left)&&!decimalRE.test(piece.leftRaw))||(requiredDecimals&&Number.isFinite(right)&&!decimalRE.test(piece.rightRaw)))return{valid:false,format:true};intervals.push({...piece,left,right});}
     intervals.sort((a,b)=>a.left-b.left||a.right-b.right);return{valid:true,intervals};
    }
    function renderIntervalAnswer(box){
     const places=Number(current.intervalAnswer?.requiredDecimals||0),help=cfg.unit3?(places?`Write every finite endpoint with exactly ${places} digits after the decimal.`:''):(places?`Use interval notation. Write every finite endpoint with exactly ${places} digits after the decimal; always use parentheses at infinity.`:'Use interval notation. Use parentheses at infinity; for increasing/decreasing intervals, include finite critical endpoints with brackets.');
     typedInput(box,{placeholder:current.intervalPlaceholder||'Enter interval notation',aria:'Interval notation answer',help,check:(input,button)=>{if(!current||current.answered)return;const received=parseIntervals(input.value,places),expected=parseIntervals(current.intervalAnswer?.expected||'',0);if(!received.valid){invalidTyped(input,received.format?`Use exactly ${places} digits after every finite decimal endpoint.`:'Enter a valid answer in interval notation.');return;}const tol=places?.000500001:1e-7,a=received.intervals||[],b=expected.intervals||[],ok=a.length===b.length&&a.every((part,i)=>part.leftClosed===b[i].leftClosed&&part.rightClosed===b[i].rightClosed&&((part.left===b[i].left)||Math.abs(part.left-b[i].left)<=tol)&&((part.right===b[i].right)||Math.abs(part.right-b[i].right)<=tol));finishTyped(input,button,ok);}});
    }
    function renderLineEquation(box){
     box.classList.add('composite-answer','line-equation-answer');
     const input=document.createElement('input');input.type='text';input.id='line-answer';input.className='practice-answer-input';input.placeholder=current.linePlaceholder||'Enter the equation of the line';input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',current.linePlaceholder||'Equation of the line');
     const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent='Check Answer';button.addEventListener('click',()=>chooseLineEquation(input,button));input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();chooseLineEquation(input,button);}});
     box.append(input,button);if(current.lineInputHint){const help=document.createElement('div');help.className='line-answer-help';help.textContent=current.lineInputHint;box.appendChild(help);}mountUnit3Keypad(input,box,keypadModeFor('line-equation'));setTimeout(()=>input.focus(),0);
    }
    function chooseLineEquation(input,button){
     if(!current||current.answered)return;const result=window.BatchMathLineEquations?.check?.(input.value,current.lineAnswer);
     if(!result||!result.valid){input.classList.add('wrong');$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result bad">${result?.message||'Enter a valid equation of a line.'} No attempt counted.</div>`;input.focus();return;}
     current.answered=true;const ok=!!result.correct;finishAnalytics(ok);input.disabled=true;button.disabled=true;input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';const formatNote=!ok&&result.message?`<div class="answer-format-note">${result.message}</div>`:'';const answer=current.lineAnswer?.answerTex||current.answerTex||current.lineAnswer?.equation||'';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':'Not quite.'}</div>${formatNote}${ok?'':`<div class="correct-answer">Correct answer: \\(${answer}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);
    }
    function parseValueList(raw){
     let s=String(raw||'').trim().replace(/[−–—]/g,'-').replace(/[{}\[\]]/g,'').replace(/\b(?:and)\b/gi,',');if(!s)return{valid:false,values:[]};
     s=s.replace(/^\s*[a-z]\s*=\s*/i,'');const parts=s.includes(',')||s.includes(';')?s.split(/[,;]+/):[s];const values=parts.map(x=>exactScalarValue(x.trim()));return{valid:parts.length>0&&values.every(Number.isFinite),values};
    }
    function renderValueList(box){
     box.classList.add('composite-answer','line-equation-answer','value-list-answer');const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=current.valueListPlaceholder||'Enter all values, separated by commas';input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label',current.valueListPlaceholder||'Values');const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent='Check Answer';button.addEventListener('click',check);input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});box.append(input,button);const help=document.createElement('div');help.className='line-answer-help';help.textContent='Separate multiple values with commas. Example: x = a, b, c, …';box.appendChild(help);mountUnit3Keypad(input,box);function check(){if(!current||current.answered)return;const parsed=parseValueList(input.value);if(!parsed.valid){input.classList.add('wrong');$('feedback').className='feedback shown';$('feedback').innerHTML='<div class="result bad">Enter a valid exact value for every requested answer. No attempt counted.</div>';input.focus();return;}const expected=[...(current.valueList?.values||[])].map(Number).sort((a,b)=>a-b),received=[...parsed.values].sort((a,b)=>a-b),ok=expected.length===received.length&&expected.every((v,i)=>Math.abs(v-received[i])<1e-7);current.answered=true;finishAnalytics(ok);input.disabled=true;button.disabled=true;input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':'Not quite.'}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);}setTimeout(()=>input.focus(),0);
    }
    function renderRoundedLineFields(box){
     box.classList.add('composite-answer','rounded-line-answer');const inputs=[];(current.roundedLines||[]).forEach((field,index)=>{const label=document.createElement('label');label.className='rounded-line-field';const title=document.createElement('span');title.textContent=current.roundedLines.length>1?`Line ${index+1}`:'Line';const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=`${field.variable} = 0.000`;input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',`Line ${index+1}: ${field.variable} equals, rounded to three decimals`);label.append(title,input);box.appendChild(label);inputs.push(input);});const button=document.createElement('button');button.type='button';button.className='choice rounded-line-check';button.textContent=current.roundedLines?.length>1?'Check All Lines':'Check Answer';button.addEventListener('click',check);inputs.forEach(input=>input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}}));box.appendChild(button);if(current.lineInputHint){const help=document.createElement('div');help.className='line-answer-help';help.textContent=current.lineInputHint;box.appendChild(help);}mountUnit3Keypad(inputs,box);function check(){if(!current||current.answered)return;const expected=(current.roundedLines||[]).map(f=>({variable:f.variable,value:Number(f.answerText)})),used=new Set(),results=inputs.map(input=>{const raw=input.value.trim().replace(/[−–—]/g,'-'),match=raw.match(/^([xy])\s*=\s*([+-]?(?:\d+\.\d{3}))$/i);if(!match)return{ok:false,format:false};const variable=match[1].toLowerCase(),value=Number(match[2]);const index=expected.findIndex((f,i)=>!used.has(i)&&f.variable===variable&&Math.abs(f.value-value)<1e-9);if(index>=0){used.add(index);return{ok:true,format:true};}return{ok:false,format:true};});const ok=results.length===expected.length&&results.every(r=>r.ok);current.answered=true;finishAnalytics(ok);inputs.forEach((input,i)=>{input.disabled=true;input.classList.add(results[i]?.ok?'correct':'wrong');});button.disabled=true;$('feedback').className='feedback shown';const badFormat=results.some(r=>!r.format);$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'Correct.':badFormat?'Use x = or y = and exactly three digits after every decimal point.':'At least one rounded line value is incorrect.'}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);}setTimeout(()=>inputs[0]?.focus(),0);
    }
    function renderCoordinateFields(box){
     box.classList.add('composite-answer','coordinate-answer');const spec=current.pointAnswer||{},fields=[['x','x-coordinate'],['y','function value']];const inputs={};
     for(const [key,title] of fields){const label=document.createElement('label');label.className='coordinate-field';const name=document.createElement('span');name.innerHTML=key==='x'?'\\(x=\\)':'\\(f(x)=\\)';const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=`Enter the ${title}`;input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label',title);label.append(name,input);box.appendChild(label);inputs[key]=input;}
     const button=document.createElement('button');button.type='button';button.className='choice coordinate-check';button.textContent='Check Both Coordinates';box.appendChild(button);
     const check=()=>{if(!current||current.answered)return;const parser=window.BatchMathDerivativeExpressions,oks={};for(const key of ['x','y']){const raw=String(inputs[key].value||'').trim().replace(/[−–—]/g,'-').replace(/^\s*(?:x|y|f\s*\(\s*x\s*\))\s*=\s*/i,'');try{parser.evaluate(parser.parse(raw),{});}catch(_){invalidTyped(inputs[key],`Enter a valid exact ${key==='x'?'x-coordinate':'function value'}.`);return;}const expected=Array.isArray(spec[key])?spec[key]:[spec[key]];oks[key]=expected.some(answer=>parser.equivalent(raw,String(answer),[{}],1e-7));}
     current.answered=true;const ok=oks.x&&oks.y;finishAnalytics(ok);for(const key of ['x','y']){inputs[key].disabled=true;inputs[key].classList.add(oks[key]?'correct':'wrong');}button.disabled=true;$('feedback').className='feedback shown';const message=ok?'Both coordinates are correct.':oks.x?'The x-coordinate is correct, but the function value is not.':oks.y?'The function value is correct, but the x-coordinate is not.':'Both coordinates need correction.';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${message}</div>${ok?'':`<div class="correct-answer">Correct point: \\(${current.answerTex}\\)</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};
     button.addEventListener('click',check);Object.values(inputs).forEach(input=>input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}}));mountUnit3Keypad(Object.values(inputs),box);typeset([box]);setTimeout(()=>inputs.x.focus(),0);
    }
    function renderParameterFields(box){box.classList.add('composite-answer','parameter-fields');const inputs=[];for(const f of current.fields||[]){const label=document.createElement('label');label.className='parameter-field';label.innerHTML=`<span>\\(${f.label}=\\)</span>`;const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.autocomplete='off';input.placeholder=`Enter ${f.label}`;input.setAttribute('aria-label',`Value of ${f.label}`);label.appendChild(input);box.appendChild(label);inputs.push(input);}let active=inputs[0];inputs.forEach(input=>{input.addEventListener('focus',()=>active=input);input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});});const hint=document.createElement('button');hint.type='button';hint.className='choice';hint.textContent='Show Hint';hint.addEventListener('click',()=>{hint.disabled=true;const d=document.createElement('div');d.className='feedback shown';d.innerHTML=current.hint||'Match the adjacent branch values at each boundary.';box.appendChild(d);typeset([d]);});const checkButton=document.createElement('button');checkButton.type='button';checkButton.className='choice';checkButton.textContent='Check All Parameters';checkButton.addEventListener('click',check);box.append(hint,checkButton);const pad=document.createElement('div');pad.className='u1-keypad';for(const [label,token] of [['7','7'],['8','8'],['9','9'],['−','-'],['4','4'],['5','5'],['6','6'],['a/b','/'],['1','1'],['2','2'],['3','3'],['.','.'],['0','0'],['⌫','backspace'],['Clear','clear']]){const b=document.createElement('button');b.type='button';b.className='u1-key';b.textContent=label;b.addEventListener('click',()=>{if(!active||active.disabled)return;let a=active.selectionStart??active.value.length,z=active.selectionEnd??a;if(token==='clear'){active.value='';a=0;}else if(token==='backspace'){if(a===z)a=Math.max(0,a-1);active.value=active.value.slice(0,a)+active.value.slice(z);}else{active.value=active.value.slice(0,a)+token+active.value.slice(z);a+=token.length;}active.focus();active.setSelectionRange(a,a);});pad.appendChild(b);}box.appendChild(pad);function check(){if(!current||current.answered)return;const parsed=inputs.map(input=>window.BMUnit1UI.parse(input.value));const bad=parsed.findIndex(p=>p.error||p.kind!=='num');if(bad>=0){inputs[bad].classList.add('wrong');$('feedback').className='feedback shown';$('feedback').dataset.answerState='invalid';$('feedback').innerHTML='<div class="result bad">Enter a valid number or fraction in every parameter field. No attempt counted.</div>';inputs[bad].focus();return;}current.answered=true;const oks=parsed.map((p,i)=>Math.abs(p.value-Number(current.fields[i].numericAnswer))<=Number(current.fields[i].numericTolerance||1e-8)),ok=oks.every(Boolean);finishAnalytics(ok);inputs.forEach((input,i)=>{input.disabled=true;input.classList.add(oks[i]?'correct':'wrong');});box.querySelectorAll('button').forEach(b=>b.disabled=true);$('feedback').dataset.answerState='answered';$('feedback').className='feedback shown';const answer=current.fields.map(f=>`\\(${f.label}=${f.answerTex}\\)`).join(', ');$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?'All parameters are correct.':'At least one parameter needs correction.'}</div>${ok?'':`<div class="correct-answer">Correct values: ${answer}</div><div class="method">${current.explanation||''}</div>`}`;$('next').hidden=false;if(ok)window.BMUnit1UI.methodButton($('feedback'),current.explanation||'',()=>window.BMAnalytics?.solutionRevealed(current,{reveal_reason:'requested_method'}));typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);}setTimeout(()=>active?.focus(),0);}
    /*
     * Unit 3 theorem/approximation engines use a shared, genuinely staged answer
     * flow. Part 1 is checked before Part 2 is exposed. A correct stage can be
     * advanced with Enter; a wrong stage requires the visible Continue/Next
     * control so one physical keypress never skips the worked feedback.
     */
    function renderStagedCalculus(box){
     const stage1=current.stage1||{},stage2=current.stage2||null;
     box.classList.add('composite-answer','staged-calculus-answer');
     if(current.unit4Meta)box.classList.add('unit4-typed-answer');
     if(current.unit4Meta?.kind==='newton')box.classList.add('unit4-newton-answer');
     if(['geometry','ftc','rules','basic','usub','log','mvt'].includes(current.unit4Meta?.kind))box.classList.add('unit4-revised-answer');
     current.blockEnterAdvance=true;current.enterAdvanceAllowed=false;current.pendingStageAdvance=null;
     current.requirePhysicalNextClick=false;current.nextPointerArmed=false;
     current.stage1Answered=false;current.stage1Correct=false;current.stage2Answered=false;current.stage2Visible=false;

     const panel=document.createElement('section');panel.className='staged-part staged-part-one';panel.setAttribute('aria-label',stage2?'Part 1':'Answer');box.appendChild(panel);
     if(!(['newton','geometry','rules'].includes(current.unit4Meta?.kind)&&stage1.hidePrompt))renderPrompt(panel,stage1.prompt||(stage2?'Part 1':'Enter your answer.'));
     renderStageControl(stage1,panel,(ok)=>finishStage1(ok));

     function renderPrompt(host,text){const prompt=document.createElement('div');prompt.className='question-prompt staged-part-prompt';prompt.innerHTML=text;host.appendChild(prompt);}
     function stageAnswerText(stage){return stage.answerTex||stage.choices?.[stage.correctIndex]||'';}
     function stageFeedback(host,stage,ok,{showExplanation=true,label='Part 1'}={}){
      const note=document.createElement('div');note.className='feedback shown staged-feedback';note.tabIndex=-1;
      const formatNote=!ok&&stage._resultNote?`<div class="answer-format-note">${stage._resultNote}</div>`:'';
      const correctAnswer=!ok&&stageAnswerText(stage)?`<div class="correct-answer">Correct answer: ${stage.answerIsText?stageAnswerText(stage):`\\(${stageAnswerText(stage)}\\)`}</div>`:'';
      const explanation=showExplanation&&stage.explanation?`<div class="method">${stage.explanation}</div>`:'';
      note.innerHTML=`<div class="result ${ok?'good':'bad'}">${ok?(stage.correctFeedback||(stage2?`${label} is correct.`:'Correct.')):(stage.incorrectFeedback||(stage2?`${label} is not correct.`:'Not correct.'))}</div>${formatNote}${correctAnswer}${explanation}`;
      host.appendChild(note);typeset([note]);return note;
     }
     function normalizeStageRaw(raw){return String(raw||'').trim().replace(/[−–—]/g,'-').replace(/^\s*(?:c|x|y|L\([^)]*\)|S\([^)]*\))\s*=\s*/i,'');}
     function decimalLiteralUsed(raw){return /(?:^|[^A-Za-z])(?:\d*\.\d+)/.test(String(raw||''));}
     function exactResult(raw,stage){
      if(stage.unit4Answer)return window.BatchMathUnit4Answers.check(raw,stage.unit4Answer);
      const cleaned=normalizeStageRaw(raw);
      if(!cleaned)return{valid:false,message:stage.requireExact?'Enter an exact answer before checking.':'Enter an answer before checking.'};
      if(stage.requireExact&&decimalLiteralUsed(cleaned))return{valid:true,ok:false,format:true};
      if(stage.type==='exact-list'){
       const parsed=parseValueList(cleaned);if(!parsed.valid)return{valid:false,message:'Enter every exact value, separated by commas.'};
       const expected=[...(stage.expectedValues||[])].map(Number).sort((a,b)=>a-b),received=[...parsed.values].sort((a,b)=>a-b),tol=Number(stage.tolerance||1e-7);
       return{valid:true,ok:expected.length===received.length&&expected.every((value,index)=>Math.abs(value-received[index])<=tol)};
      }
      if(Array.isArray(stage.acceptedExpressions)&&stage.acceptedExpressions.length){
       const parser=window.BatchMathDerivativeExpressions;
       if(parser?.parse&&parser?.evaluate&&parser?.equivalent){
        try{parser.evaluate(parser.parse(cleaned),{});}catch(_){return{valid:false,message:stage.requireExact?'Enter a valid exact numerical expression.':'Enter a valid numerical expression.'};}
        const tolerance=Number(stage.tolerance||1e-7);
        return{valid:true,ok:stage.acceptedExpressions.some(expected=>parser.equivalent(cleaned,String(expected),[{}],tolerance))};
       }
      }
      const value=exactScalarValue(cleaned);if(!Number.isFinite(value))return{valid:false,message:stage.requireExact?'Enter a valid exact numerical expression.':'Enter a valid numerical expression.'};
      return{valid:true,ok:Math.abs(value-Number(stage.numericAnswer))<=Number(stage.tolerance||1e-7)};
     }
     function renderStageControl(stage,host,done){
      if(stage.type==='choice'){
       const grid=document.createElement('div');grid.className='choice-grid staged-choice-grid';host.appendChild(grid);
       (stage.choices||[]).forEach((choice,index)=>{const button=document.createElement('button');button.type='button';button.className='choice staged-choice';button.innerHTML=choice;button.addEventListener('click',()=>{if(stage._answered)return;stage._answered=true;const ok=index===stage.correctIndex;grid.querySelectorAll('.choice').forEach((item,itemIndex)=>{item.disabled=true;if(itemIndex===stage.correctIndex)item.classList.add('correct');else if(itemIndex===index)item.classList.add('wrong');});done(ok);});grid.appendChild(button);});
       return;
      }
      const input=document.createElement('input');input.type='text';input.className='practice-answer-input staged-exact-input';input.placeholder=stage.placeholder||'Enter an exact answer';input.autocomplete='off';input.autocapitalize='off';input.spellcheck=false;input.setAttribute('aria-label',stage.ariaLabel||stage.placeholder||'Exact answer');
      const button=document.createElement('button');button.type='button';button.className='choice staged-check';button.textContent=stage.checkLabel||(!stage2?'Check Answer':stage===stage1?'Check Part 1':'Check Part 2');
      const invalid=document.createElement('div');invalid.className='staged-input-message';invalid.setAttribute('aria-live','polite');
      const check=()=>{if(stage._answered)return;const result=exactResult(input.value,stage);if(!result.valid){input.classList.add('wrong');invalid.textContent=result.message;input.focus();return;}stage._answered=true;stage._resultNote=result.note||'';invalid.textContent='';input.disabled=true;button.disabled=true;input.classList.add(result.ok?'correct':'wrong');done(result.ok);};
      button.addEventListener('click',check);input.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();event.stopPropagation();check();}});
      host.append(input,button,invalid);mountUnit3Keypad(input,host,stage.keypadMode||'unit3-exact',check);setTimeout(()=>input.focus(),0);
     }
     function finishStage1(ok){
      current.stage1Answered=true;current.stage1Correct=ok;
      const showExplanation=!ok||stage1.explainOnCorrect!==false;
      const note=stageFeedback(panel,stage1,ok,{showExplanation,label:'Part 1'});
      if(!stage2){finishProblem(ok,note,ok);return;}
      if(ok&&stage1.autoAdvanceOnCorrect){
       current.stage2Visible=true;current.pendingStageAdvance=null;current.enterAdvanceAllowed=false;
       renderPart2();return;
      }
      const continueButton=document.createElement('button');continueButton.type='button';continueButton.className='choice staged-continue';continueButton.textContent='Continue to Part 2';
      const advance=()=>{if(current.stage2Visible)return;current.stage2Visible=true;current.pendingStageAdvance=null;current.enterAdvanceAllowed=false;continueButton.disabled=true;continueButton.hidden=true;renderPart2();};
      continueButton.addEventListener('click',advance);
      continueButton.addEventListener('keydown',event=>{if(event.key==='Enter'&&!current.stage1Correct){event.preventDefault();event.stopPropagation();}});
      panel.appendChild(continueButton);current.pendingStageAdvance=advance;current.enterAdvanceAllowed=ok;
      if(ok)setTimeout(()=>continueButton.focus(),0);else setTimeout(()=>note.focus(),0);
     }
     function renderPart2(){
      const part=document.createElement('section');part.className='staged-part staged-part-two';part.setAttribute('aria-label','Part 2');
      if(current.unit4Meta){
       box.insertBefore(part,panel);panel.classList.add('staged-completed');
       panel.querySelectorAll('.bm-calc-keypad,.staged-check,.staged-continue').forEach(e=>e.hidden=true);
       const heading=document.createElement('h3');heading.className='staged-review-heading';heading.textContent='Completed Part 1';panel.prepend(heading);
      }else box.appendChild(part);
      renderPrompt(part,stage2.prompt||'Part 2');
      renderStageControl(stage2,part,(ok)=>{current.stage2Answered=true;const note=stageFeedback(part,stage2,ok,{showExplanation:true,label:'Part 2'});finishProblem(current.stage1Correct&&ok,note,ok);});
      const ready=typeset([part]);
      if(current.unit4Meta){part.tabIndex=-1;ready.then(()=>requestAnimationFrame(()=>{if(!part.isConnected)return;part.focus({preventScroll:true});window.scrollTo({top:Math.max(0,window.scrollY+part.getBoundingClientRect().top-24),behavior:'instant'});}));}
     }
     function finishProblem(overallOk,note,lastStageOk=overallOk){
      const allowNext=Boolean(lastStageOk||current.unit4Meta);
      current.answered=true;current.pendingStageAdvance=null;current.enterAdvanceAllowed=allowNext;current.requirePhysicalNextClick=!allowNext;current.nextPointerArmed=false;finishAnalytics(overallOk);$('next').hidden=false;
      if(allowNext)setTimeout(()=>{try{$('next').focus({preventScroll:true});}catch(_){$('next').focus();}},0);else setTimeout(()=>note?.focus(),0);
     }
    }

    function renderApproximationFields(box){
     box.classList.add('composite-answer','approximation-fields');const value=document.createElement('input'),kind=document.createElement('input');value.type=kind.type='text';value.className=kind.className='practice-answer-input';value.placeholder='Enter the approximation';kind.placeholder='Enter underestimate or overestimate';value.autocomplete=kind.autocomplete='off';value.setAttribute('aria-label','Approximation');kind.setAttribute('aria-label','Underestimate or overestimate');const button=document.createElement('button');button.type='button';button.className='choice line-check';button.textContent='Check Both Answers';box.append(value,kind,button);mountUnit3Keypad([value,kind],box);const check=()=>{if(!current||current.answered)return;const numeric=numericValue(value.value),word=normalizeWords(kind.value).replace(/\s+/g,''),expected=current.approximationAnswer||{},numericOk=Number.isFinite(numeric)&&Math.abs(numeric-Number(expected.value))<=Number(current.numericTolerance||.001),classOk=expected.classification==='under'?['under','underestimate'].includes(word):['over','overestimate'].includes(word);if(!Number.isFinite(numeric)||!word){invalidTyped(!Number.isFinite(numeric)?value:kind,'Enter both the approximation and its classification.');return;}current.answered=true;const ok=numericOk&&classOk;finishAnalytics(ok);value.disabled=kind.disabled=button.disabled=true;value.classList.add(numericOk?'correct':'wrong');kind.classList.add(classOk?'correct':'wrong');$('feedback').className='feedback shown';const message=ok?'Both entries are correct.':numericOk?'The approximation is correct, but the classification is not.':classOk?'The classification is correct, but the approximation is not.':'Both entries need correction.';$('feedback').innerHTML=`<div class="result ${ok?'good':'bad'}">${message}</div>${ok?'':`<div class="correct-answer">Correct answer: \\(${current.answerTex||current.numericAnswer}\\), ${expected.classification==='under'?'underestimate':'overestimate'}</div>`}<div class="method">${current.explanation||''}</div>`;$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};button.addEventListener('click',check);for(const input of [value,kind])input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});setTimeout(()=>value.focus(),0);
    }
    function renderComposite(box){box.classList.add('composite-answer');const input=document.createElement('input');input.type='text';input.id='approx-answer';input.className='practice-answer-input';input.placeholder='Approximation';input.autocomplete='off';input.setAttribute('aria-label','Approximation');box.appendChild(input);const row=document.createElement('div');row.className='classification-row';[['under','Underestimate'],['over','Overestimate']].forEach(([key,label])=>{const b=document.createElement('button');b.type='button';b.className='choice classification-choice';b.textContent=label;b.dataset.classification=key;b.addEventListener('click',()=>chooseComposite(key,b,input));row.appendChild(b)});box.appendChild(row);setTimeout(()=>input.focus(),0);}
