     const parser=window.BatchMathDerivativeExpressions;try{parser.evaluate(parser.parse(String(raw)),{});}catch(_){return false;}const values=Array.isArray(expected)?expected:[expected];return values.some(value=>parser.equivalent(String(raw),String(value),[{}],1e-7));
    }
    function renderOrderedPair(box){
     box.classList.add('composite-answer','ordered-pair-answer');const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder='Enter the ordered pair (x, y)';input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label','Ordered pair');const button=document.createElement('button');button.type='button';button.className='choice ordered-pair-check';button.textContent='Check Ordered Pair';box.append(input,button);
     const check=()=>{if(!current||current.answered)return;const received=splitOrderedPair(input.value),expected=current.pointAnswer||{};if(!received){invalidTyped(input,'Enter one ordered pair in the form (x, y).');return;}const xOk=equivalentExact(received.x,expected.x),yOk=equivalentExact(received.y,expected.y),ok=xOk&&yOk;current.answered=true;finishAnalytics(ok);input.disabled=button.disabled=true;input.classList.add(ok?'correct':'wrong');$('feedback').className='feedback shown';const message=ok?'The ordered pair is correct.':xOk?'The x-coordinate is correct, but the y-coordinate is not.':yOk?'The y-coordinate is correct, but the x-coordinate is not.':'Both coordinates need correction.';$('feedback').innerHTML='<div class="result '+(ok?'good':'bad')+'">'+message+'</div>'+(ok?'':'<div class="correct-answer">Correct point: \\('+current.answerTex+'\\)</div>')+'<div class="method">'+(current.explanation||'')+'</div>';$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};
     button.addEventListener('click',check);input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}});mountUnit3Keypad(input,box);setTimeout(()=>input.focus(),0);
    }
    function renderExtremumFields(box){
     box.classList.add('composite-answer','extremum-answer');const spec=current.extremumAnswer||{},kind=spec.kind==='minimum'?'minimum':'maximum',fields=[['value','Local '+kind+':','Maximum or minimum value'],['location','Location of '+kind+':','Location of maximum or minimum']];const inputs={};
     for(const [key,labelText,aria] of fields){const label=document.createElement('label');label.className='extremum-field';const title=document.createElement('span');title.textContent=labelText;const input=document.createElement('input');input.type='text';input.className='practice-answer-input';input.placeholder=key==='value'?'Enter the local '+kind+' value':'Enter where it occurs';input.autocomplete='off';input.spellcheck=false;input.setAttribute('aria-label',aria);label.append(title,input);box.appendChild(label);inputs[key]=input;}
     const button=document.createElement('button');button.type='button';button.className='choice extremum-check';button.textContent='Check Both Answers';box.appendChild(button);
     const check=()=>{if(!current||current.answered)return;for(const key of ['value','location']){if(!String(inputs[key].value||'').trim()){invalidTyped(inputs[key],'Enter both the extremum value and its location.');return;}}const valueOk=equivalentExact(String(inputs.value.value).replace(/^\s*(?:local\s+)?(?:maximum|minimum)\s*=\s*/i,''),spec.value),locationOk=equivalentExact(String(inputs.location.value).replace(/^\s*x\s*=\s*/i,''),spec.location),ok=valueOk&&locationOk;current.answered=true;finishAnalytics(ok);for(const [key,input] of Object.entries(inputs)){input.disabled=true;input.classList.add((key==='value'?valueOk:locationOk)?'correct':'wrong');}button.disabled=true;$('feedback').className='feedback shown';const message=ok?'Both entries are correct.':valueOk?'The extremum value is correct, but its location is not.':locationOk?'The location is correct, but the extremum value is not.':'Both entries need correction.';$('feedback').innerHTML='<div class="result '+(ok?'good':'bad')+'">'+message+'</div>'+(ok?'':'<div class="correct-answer">Correct answer: \\('+current.answerTex+'\\)</div>')+'<div class="method">'+(current.explanation||'')+'</div>';$('next').hidden=false;typeset([$('feedback')]);setTimeout(()=>$('next').focus(),0);};
     button.addEventListener('click',check);Object.values(inputs).forEach(input=>input.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();check();}}));mountUnit3Keypad(Object.values(inputs),box);setTimeout(()=>inputs.value.focus(),0);
    }
